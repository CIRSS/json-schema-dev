#!/usr/bin/env node
// Validate a JSON instance against a JSON Schema, at the 2020-12 dialect.
//
// Usage: ajv-validate --schema FILE --instance FILE [--ref FILE]...
//                     [--reject-duplicate-members]
//                     [--ignore-declared-version]
//                     [--text FILE|-] [--json FILE|-]
//
// Arguments are named, not positional, so the schema and instance cannot be
// swapped by accident. Uses Ajv's 2020-12 build so the verdict is directly
// comparable with jsonschema-validate. Each --ref FILE loads an additional
// schema and registers it under its $id, making it available to $ref in the
// main schema -- this is how a schema spread over several files is validated
// against. A --ref schema must carry a $id; there is nothing else to register
// it under. --reject-duplicate-members makes a duplicate object member name
// anywhere in the instance an INVALID verdict: JSON's grammar permits
// duplicates but parsers silently keep the last value, so no schema can ever
// see one -- parse time is the only tier that can check. A schema (or ref
// schema) whose top-level "$schema" entry names any version other than
// 2020-12 is refused (exit 2): validating it under 2020-12 semantics could
// silently change its meaning. --ignore-declared-version overrides the
// refusal by discarding the declaration and validating as 2020-12 anyway --
// an explicit choice, never a silent one. The verdict has two forms, and a
// run may ask for either or both: --text writes the lines a caller has
// always got, `VALID` or one `INVALID: ...` per error, and --json writes a
// report carrying each finding's location as segments, the keyword that
// failed, where that keyword lives, and the identity of what offended.
// Either takes a file, or - for stdout; passing neither writes the text
// form to stdout. Diagnostics go to stderr. Exit status:
//
//     0  the instance is valid
//     1  the instance is invalid -- including an instance file that is not
//        valid JSON: the parse failure is a verdict about the submitted
//        document (its lowest grammar tier), not an operational error
//     2  error (bad arguments, unreadable file, schema or ref file with
//        malformed JSON, invalid schema, a --ref schema without $id)
'use strict';

const fs = require('fs');
const { parseArgs } = require('node:util');
const Ajv2020Module = require('ajv/dist/2020');
const Ajv2020 = Ajv2020Module.default || Ajv2020Module;

const PROG = 'ajv-validate';
const USAGE = `usage: ${PROG} --schema FILE --instance FILE [--ref FILE]... [--reject-duplicate-members] [--ignore-declared-version] [--text FILE|-] [--json FILE|-]`;
const EXIT_VALID = 0;
const EXIT_INVALID = 1;
const EXIT_ERROR = 2;
const SUPPORTED_VERSION_URI = 'https://json-schema.org/draft/2020-12/schema';

function die(message) {
  process.stderr.write(`${PROG}: error: ${message}\n`);
  process.exit(EXIT_ERROR);
}

function readText(path, role) {
  try {
    return fs.readFileSync(path, 'utf8');
  } catch (e) {
    if (e.code === 'ENOENT') die(`${role} file not found: ${path}`);
    if (e.code === 'EISDIR') die(`${role} path is a directory: ${path}`);
    die(`cannot read ${role} file ${path}: ${e.message}`);
  }
}

function loadJson(path, role) {
  const text = readText(path, role);
  try {
    return JSON.parse(text);
  } catch (e) {
    die(`${role} file ${path} is not valid JSON: ${e.message}`);
  }
}

function parseCli() {
  let values;
  try {
    ({ values } = parseArgs({
      args: process.argv.slice(2),
      options: {
        schema: { type: 'string', short: 's' },
        instance: { type: 'string', short: 'i' },
        ref: { type: 'string', short: 'r', multiple: true },
        'reject-duplicate-members': { type: 'boolean' },
        'ignore-declared-version': { type: 'boolean' },
        text: { type: 'string' },
        json: { type: 'string' },
        help: { type: 'boolean', short: 'h' },
      },
      allowPositionals: false,
    }));
  } catch (e) {
    process.stderr.write(`${PROG}: error: ${e.message}\n${USAGE}\n`);
    process.exit(EXIT_ERROR);
  }
  if (values.help) {
    process.stdout.write(USAGE + '\n');
    process.exit(EXIT_VALID);
  }
  if (!values.schema || !values.instance) {
    process.stderr.write(`${PROG}: error: both --schema and --instance are required\n${USAGE}\n`);
    process.exit(EXIT_ERROR);
  }
  if (values.text === '-' && values.json === '-') {
    die('--text and --json cannot both write to stdout');
  }
  if (values.text === undefined && values.json === undefined) values.text = '-';
  return values;
}

// Keywords whose failure states that some subschema failed rather than
// stating anything about the instance. Ajv reports a conclusion for these
// beside the failure inside them; python-jsonschema descends and reports
// only the failure. Dropping them is what makes the two legs describe one
// thing -- and the line they contribute, "must match \"then\" schema",
// names a keyword rather than a problem.
const TRANSPARENT_KEYWORDS = new Set([
  'if', 'then', 'else', '$ref', 'properties', 'patternProperties',
  'propertyNames', 'items', 'prefixItems', 'allOf', 'dependentSchemas',
  'unevaluatedItems',
]);

// Keywords whose failure is a conclusion about subschemas that were tried,
// with the reasons underneath it. Unlike a transparent conclusion, this one
// is a finding: the reasons are the only place the detail exists.
const BRANCHING_KEYWORDS = new Set(['anyOf', 'oneOf', 'contains', 'not']);

// Ajv reports a location as a rendered JSON Pointer, in which "/0" is
// produced both by an array's first element and by a member named "0". The
// string cannot carry the difference, so it is recovered by walking the
// instance beside the path: standing on an array makes the segment an index,
// standing on an object makes it a member name.
function pathSegments(instancePath, instance) {
  if (!instancePath) return [];
  const segments = [];
  let node = instance;
  for (const raw of instancePath.slice(1).split('/')) {
    const token = raw.replace(/~1/g, '/').replace(/~0/g, '~');
    const segment = Array.isArray(node) ? Number(token) : token;
    segments.push(segment);
    node = node === undefined || node === null ? undefined : node[segment];
  }
  return segments;
}

// Every name a $ref can use, mapped to a document and a path into it.
//
// A schema names parts of itself two ways: an $id on a subschema, which
// makes it a resource in its own right, and an $anchor, which names a spot
// without making one. Both are navigation aids rather than report
// coordinates: a clause is always reported as a path from the root of a
// document the caller handed over, because that is the file a reader has.
function indexDocuments(schema, refSchemas) {
  const index = new Map();

  const walk = (node, document, base, path) => {
    if (Array.isArray(node)) {
      node.forEach((item, i) => walk(item, document, base, [...path, i]));
      return;
    }
    if (node === null || typeof node !== 'object') return;
    if (typeof node.$id === 'string' && path.length) {
      base = node.$id;
      index.set(node.$id, { document, path });
    }
    if (typeof node.$anchor === 'string') {
      index.set(`${base ?? ''}#${node.$anchor}`, { document, path });
    }
    for (const [key, item] of Object.entries(node)) {
      walk(item, document, base, [...path, key]);
    }
  };

  index.set('#', { document: schema, path: [] });
  walk(schema, schema, null, []);
  for (const ref of refSchemas) {
    if (ref.$id) index.set(ref.$id, { document: ref, path: [] });
    walk(ref, ref, ref.$id ?? null, []);
  }
  return index;
}

// Every subschema object in every supplied document, by identity, mapped to
// the document and the path that reaches it. Ajv hands back the very object
// a keyword sits in, so this locates it exactly rather than by parsing a
// pointer the library composed.
function indexSubschemas(schema, refSchemas) {
  const index = new Map();

  const walk = (node, document, path) => {
    if (node === null || typeof node !== 'object') return;
    if (!index.has(node)) index.set(node, { document, path });
    const entries = Array.isArray(node)
      ? node.map((item, i) => [i, item])
      : Object.entries(node);
    for (const [key, item] of entries) walk(item, document, [...path, key]);
  };

  walk(schema, schema, []);
  for (const ref of refSchemas) walk(ref, ref, []);
  return index;
}

// Where the failing keyword lives, as a document and a path into it.
//
// Ajv renders this as one string, joining whatever named the subschema to
// the path within it -- "#/properties/a/type" for the schema on the command
// line, "#named/..." for an anchor, "https://example.org/named/..." for an
// $id whether it sits in a --ref file or inside the main schema. The name is
// recovered by taking the longest key the index knows, and what follows is
// the path below it.
// Ajv names a boolean schema's failure "false schema", a keyword no schema
// contains. There is nothing to name -- the schema is a boolean -- so the
// report omits the keyword and locates the boolean itself.
const PSEUDO_KEYWORD = 'false schema';

function ruleLocation(err, schema, index, subschemas) {
  const found = err.parentSchema !== null && typeof err.parentSchema === 'object'
    ? subschemas.get(err.parentSchema)
    : undefined;
  if (found) {
    const inside = Object.prototype.hasOwnProperty.call(err.parentSchema, err.keyword);
    return {
      document: found.document === schema ? null : (found.document.$id ?? null),
      path: inside ? [...found.path, err.keyword] : found.path,
    };
  }
  const named = ruleLocationByName(err.schemaPath, schema, index);
  if (err.keyword === PSEUDO_KEYWORD
      && named.path[named.path.length - 1] === PSEUDO_KEYWORD) {
    named.path = named.path.slice(0, -1);
  }
  return named;
}

function ruleLocationByName(schemaPath, schema, index) {
  let best = null;
  for (const key of index.keys()) {
    if (schemaPath !== key
        && !schemaPath.startsWith(`${key}/`)
        && !schemaPath.startsWith(`${key}#`)) continue;
    if (!best || key.length > best.length) best = key;
  }
  if (best === null) {
    // A clause we cannot locate is a defect in this program, not a verdict:
    // reporting a plausible partial location would put a place in the report
    // that the keyword is not at, which is the one thing the report exists
    // to prevent. So the run stops and says so.
    die(`cannot locate the keyword that failed: ${schemaPath} names nothing `
        + 'this run was given');
  }
  const { document, path } = index.get(best);
  let rest = schemaPath.slice(best.length);
  if (rest.startsWith('#')) rest = rest.slice(1);
  let node = document;
  for (const step of path) node = node[step];
  return {
    document: document === schema ? null : (document.$id ?? null),
    path: [...path, ...pathSegments(rest, node)],
  };
}

// errorMessage is a nonstandard keyword that both libraries ignore, so both
// wrappers read it out of the schema JSON themselves and implement it the
// same way. A message lookup walks outward from the failing keyword through
// every subschema that led to it, and neither library reports that route
// whole -- python-jsonschema erases each $ref it followed, Ajv reports the
// route from the referenced resource's root -- so the route is found here by
// following the instance path down from the root, resolving every $ref on
// the way, until the failing keyword's own subschema is reached.
const DESCENDING_BY_KEY = ['additionalProperties', 'unevaluatedProperties'];
const DESCENDING_BY_INDEX = ['items', 'contains', 'unevaluatedItems'];
const NON_DESCENDING_LISTS = ['allOf', 'anyOf', 'oneOf'];
const NON_DESCENDING_SINGLES = ['not', 'if', 'then', 'else', 'propertyNames'];

// The keywords whose object-form message is keyed by the member at fault,
// and the field of the error's params that names that member.
const MEMBER_MESSAGE_KEYWORDS = { required: 'missingProperty' };

const isObject = (value) => value !== null && typeof value === 'object' && !Array.isArray(value);
const has = (object, key) => Object.prototype.hasOwnProperty.call(object, key);

// The value a JSON Pointer names below node; throws where it names none.
function descendPointer(node, pointer) {
  for (const raw of pointer ? pointer.split('/').slice(1) : []) {
    const token = raw.replace(/~1/g, '/').replace(/~0/g, '~');
    if (Array.isArray(node)) {
      if (!/^[0-9]+$/.test(token)) throw new Error(token);
      if (!has(node, Number(token))) throw new Error(token);
      node = node[Number(token)];
    } else if (isObject(node)) {
      if (!has(node, token)) throw new Error(token);
      node = node[token];
    } else {
      throw new Error(token);
    }
  }
  return node;
}

// Where a $ref leads, as { node, base }, or null where it leads nowhere. A
// reference that resolves to nothing is a dead branch of the search rather
// than a verdict: validation already reached the failing keyword, so the
// route to it resolves, and a branch that does not is not the route.
function refTarget(reference, base, index) {
  const hash = reference.indexOf('#');
  const uri = hash < 0 ? reference : reference.slice(0, hash);
  let fragment = hash < 0 ? '' : reference.slice(hash + 1);
  try {
    let entry;
    if (uri) {
      entry = index.get(uri);
      base = uri;
    } else {
      entry = index.get(base ? base : '#');
    }
    if (!entry) return null;
    if (fragment && !fragment.startsWith('/')) {
      entry = index.get(`${base ?? ''}#${fragment}`);
      if (!entry) return null;
      fragment = '';
    }
    let node = entry.document;
    for (const step of entry.path) node = node[step];
    return { node: descendPointer(node, fragment), base };
  } catch {
    return null;
  }
}

// The subschemas from the root down to the failing keyword's own, each
// paired with the instance location it was applied at. Found by following
// dataPath from the root and resolving every $ref on the way; the search
// ends at the subschema Ajv says the keyword sits in, matched by identity.
// A boolean subschema has no identity of its own, so it is matched where
// the path runs out.
function enclosingChain(schema, index, dataPath, target) {
  const wantsObject = isObject(target);
  const seen = new Map();

  const search = (node, base, remaining, chain) => {
    let lengths = seen.get(node);
    if (!lengths) {
      lengths = new Set();
      seen.set(node, lengths);
    }
    if (lengths.has(remaining.length)) return null;
    lengths.add(remaining.length);

    const here = [...chain, { node, at: dataPath.slice(0, dataPath.length - remaining.length) }];
    if (wantsObject ? node === target : (remaining.length === 0 && node === target)) return here;
    if (!isObject(node)) return null;

    let found;
    if (typeof node.$ref === 'string') {
      const resolved = refTarget(node.$ref, base, index);
      if (resolved && (found = search(resolved.node, resolved.base, remaining, here))) return found;
    }
    if (typeof node.$id === 'string' && chain.length) base = node.$id;

    if (remaining.length) {
      const [segment, ...rest] = remaining;
      if (typeof segment === 'string') {
        if (isObject(node.properties) && has(node.properties, segment)
            && (found = search(node.properties[segment], base, rest, here))) return found;
        if (isObject(node.patternProperties)) {
          for (const [pattern, child] of Object.entries(node.patternProperties)) {
            if (new RegExp(pattern).test(segment)
                && (found = search(child, base, rest, here))) return found;
          }
        }
        for (const keyword of DESCENDING_BY_KEY) {
          if (has(node, keyword) && (found = search(node[keyword], base, rest, here))) return found;
        }
      } else {
        if (Array.isArray(node.prefixItems) && segment < node.prefixItems.length
            && (found = search(node.prefixItems[segment], base, rest, here))) return found;
        for (const keyword of DESCENDING_BY_INDEX) {
          if (has(node, keyword) && (found = search(node[keyword], base, rest, here))) return found;
        }
      }
    }
    for (const keyword of NON_DESCENDING_LISTS) {
      if (!Array.isArray(node[keyword])) continue;
      for (const child of node[keyword]) {
        if ((found = search(child, base, remaining, here))) return found;
      }
    }
    for (const keyword of NON_DESCENDING_SINGLES) {
      if (has(node, keyword) && (found = search(node[keyword], base, remaining, here))) return found;
    }
    if (isObject(node.dependentSchemas)) {
      for (const child of Object.values(node.dependentSchemas)) {
        if ((found = search(child, base, remaining, here))) return found;
      }
    }
    return null;
  };

  return search(schema, null, dataPath, []);
}

// The message the schema's author wrote for this failure, interpolated, or
// null where no message covers it. The nearest message wins: the lookup
// walks outward from the failing keyword's own subschema. In that subschema
// an object form is keyed by keyword, or by member name under "required";
// in an enclosing one it is keyed by the member or element the failure
// lies under ("properties", "items"); a string, or "_" in an object, covers
// everything beneath.
function authoredMessage(err, schema, instance, index) {
  const dataPath = pathSegments(err.instancePath, instance);
  const chain = enclosingChain(schema, index, dataPath, err.parentSchema);
  if (!chain) return null;
  const innermost = chain.length - 1;
  for (let i = innermost; i >= 0; i -= 1) {
    const { node, at } = chain[i];
    if (!isObject(node)) continue;
    const declared = node.errorMessage;
    if (typeof declared === 'string') return interpolate(declared, instance, at);
    if (!isObject(declared)) continue;
    if (i === innermost) {
      const message = declared[err.keyword];
      if (typeof message === 'string') return interpolate(message, instance, at);
      if (isObject(message) && has(MEMBER_MESSAGE_KEYWORDS, err.keyword)) {
        const member = err.params?.[MEMBER_MESSAGE_KEYWORDS[err.keyword]];
        if (typeof member === 'string' && typeof message[member] === 'string') {
          return interpolate(message[member], instance, at);
        }
      }
    } else if (at.length < dataPath.length) {
      const segment = dataPath[at.length];
      if (typeof segment === 'string' && isObject(declared.properties)
          && typeof declared.properties[segment] === 'string') {
        return interpolate(declared.properties[segment], instance, [...at, segment]);
      }
      if (typeof segment === 'number' && Array.isArray(declared.items)
          && typeof declared.items[segment] === 'string') {
        return interpolate(declared.items[segment], instance, [...at, segment]);
      }
    }
    if (typeof declared._ === 'string') return interpolate(declared._, instance, at);
  }
  return null;
}

// JSON, as JSON.stringify lays it out -- the layout the other leg matches.
function encode(value) {
  if (value === undefined) throw new Error('nothing to encode');
  return JSON.stringify(value);
}

// Replace each ${pointer} with the instance value it names, JSON-encoded. An
// absolute JSON Pointer (${/artifacts/0}) resolves from the instance root. A
// relative one (${0}, ${1/digest}, ${0#}) resolves from `at`, the location
// the message is written for: the integer climbs that many levels, a
// following path descends from there, and a trailing # gives the member
// name or index at that level. A pointer that resolves to nothing is left
// in the message as written.
function interpolate(message, instance, at) {
  return message.replace(/\$\{([^}]*)\}/g, (whole, pointer) => {
    try {
      if (pointer === '' || pointer.startsWith('/')) return encode(descendPointer(instance, pointer));
      const relative = /^(0|[1-9][0-9]*)(#|\/.*)?$/.exec(pointer);
      if (!relative) return whole;
      const up = Number(relative[1]);
      const tail = relative[2] ?? '';
      if (up > at.length) return whole;
      if (tail === '#') {
        if (up === at.length) return whole;
        return encode(at[at.length - up - 1]);
      }
      let node = instance;
      for (const segment of at.slice(0, at.length - up)) {
        if (node === null || typeof node !== 'object' || !has(node, segment)) throw new Error(segment);
        node = node[segment];
      }
      return encode(descendPointer(node, tail));
    } catch {
      return whole;
    }
  });
}

// The nearest branching conclusion enclosing this error, by schema pointer.
// A branch subschema's errors are reported under "#/<keyword>/<index>/", so
// the prefix is the structural relation Ajv provides rather than a guess --
// and taking the nearest rather than any nests an applicator inside an
// applicator correctly.
function enclosingConclusion(err, conclusions) {
  let nearest = null;
  for (const candidate of conclusions) {
    if (candidate === err) continue;
    if (!err.schemaPath.startsWith(`${candidate.schemaPath}/`)) continue;
    if (!nearest || candidate.schemaPath.length > nearest.schemaPath.length) {
      nearest = candidate;
    }
  }
  return nearest;
}

// Which of a keyword's params state what the schema demanded, as against
// the particulars of the violation. Across every keyword handled here the
// two never both apply, so the split works out as a tag on which kind this
// keyword carries.
const CONSTRAINT_PARAMS = new Set([
  'allowedValues', 'allowedValue', 'type', 'pattern', 'multipleOf',
  'limit', 'minContains', 'comparison',
]);

function errorEntry(err, instance, schema, index, subschemas) {
  const params = { ...err.params };
  delete params.errors;
  const constraint = {};
  const particulars = {};
  for (const [key, value] of Object.entries(params)) {
    (CONSTRAINT_PARAMS.has(key) ? constraint : particulars)[key] = value;
  }
  const rule = ruleLocation(err, schema, index, subschemas);
  const entry = {
    site: pathSegments(err.instancePath, instance),
    keyword: err.keyword === PSEUDO_KEYWORD ? null : err.keyword,
    clause: rule.path,
    document: rule.document,
    constraint,
    particulars,
    message: err.message,
  };
  if (err.keyword === 'additionalProperties' || err.keyword === 'unevaluatedProperties') {
    const member = particulars.additionalProperty ?? particulars.unevaluatedProperty;
    if (member !== undefined) entry.site = [...entry.site, member];
  }
  // Under propertyNames the thing checked is a member's name, which Ajv
  // locates at the object holding it and carries as err.propertyName.
  // Located at that member instead, each name rejected is its own finding,
  // and the site's last segment is the name; there is no value to report,
  // so `nameChecked` is scaffolding telling withFound to leave found out.
  if (err.propertyName !== undefined) {
    entry.site = [...entry.site, err.propertyName];
    entry.nameChecked = true;
  }
  return entry;
}

// Which branch of a conclusion a cause came from. For anyOf and oneOf that
// is the segment of the schema pointer just past the applicator; for
// contains it is the element the cause is about, which is in the instance
// pointer instead -- an element that had matched would have satisfied the
// clause on its own.
function branchOf(cause, conclusion, instance) {
  if (conclusion.keyword === 'contains') {
    const segments = pathSegments(cause.instancePath, instance);
    return segments[pathSegments(conclusion.instancePath, instance).length];
  }
  const rest = cause.schemaPath.slice(conclusion.schemaPath.length + 1);
  const first = rest.split('/')[0];
  return /^[0-9]+$/.test(first) ? Number(first) : first;
}

function errorsFrom(rawErrors, instance, schema, index, subschemas) {
  const errors = rawErrors.filter((err) => !TRANSPARENT_KEYWORDS.has(err.keyword));
  const conclusions = errors.filter((err) => BRANCHING_KEYWORDS.has(err.keyword));
  const entries = new Map();
  for (const err of errors) entries.set(err, errorEntry(err, instance, schema, index, subschemas));

  const top = [];
  for (const err of errors) {
    const conclusion = enclosingConclusion(err, conclusions);
    if (!conclusion) {
      top.push(entries.get(err));
      continue;
    }
    const owner = entries.get(conclusion);
    const branch = branchOf(err, conclusion, instance);
    const rejections = (owner.rejections ??= []);
    let rejection = rejections.find((r) => r.branch === branch);
    if (!rejection) {
      rejection = conclusion.keyword === 'contains'
        ? { branch, site: [...entries.get(conclusion).site, branch], errors: [] }
        : { branch, clause: [...entries.get(conclusion).clause, branch], errors: [] };
      rejections.push(rejection);
    }
    rejection.errors.push(entries.get(err));
  }
  return top;
}

// The value the report points at: the instance walked by the entry's own
// site, resolved here rather than taken from what the library attached to
// the error. The two differ wherever a site is relocated -- an
// additionalProperties failure is reported at the offending member while
// Ajv's own data is the parent -- so resolving against the finished path,
// once, is what makes "found is the value at site" a property of the report
// rather than an intention.
function valueAt(site, instance) {
  let node = instance;
  for (const segment of site) {
    if (node === null || typeof node !== 'object'
        || !Object.prototype.hasOwnProperty.call(node, segment)) {
      // A site that does not resolve is a defect in this program, not a
      // verdict: the report would be naming a place the instance does not
      // have. Same stance as an unlocatable clause.
      die(`cannot resolve the site that failed: /${site.join('/')} names `
          + 'nothing in the instance');
    }
    node = node[segment];
  }
  return node;
}

// The report's fields, in the order they are written, and the members of
// `constraint` and `particulars` sorted. Stated here because `found` is
// filled in a pass after the rest, and because the two legs must write
// byte-identical reports where each library hands its params over in its
// own order.
const FIELD_ORDER = [
  'site', 'keyword', 'clause', 'document',
  'constraint', 'particulars', 'found', 'message', 'rejections',
];
const SORTED_FIELDS = ['constraint', 'particulars'];

// Fill each entry's `found` from its own site, throughout the report.
function withFound(errors, instance) {
  return errors.map((entry) => {
    const value = valueAt(entry.site ?? [], instance);
    const filled = entry.nameChecked ? { ...entry } : { ...entry, found: value };
    if (filled.rejections) {
      filled.rejections = filled.rejections.map(
        (rejection) => ({ ...rejection, errors: withFound(rejection.errors, instance) }));
    }
    for (const field of SORTED_FIELDS) {
      if (isObject(filled[field])) {
        filled[field] = Object.fromEntries(
          Object.keys(filled[field]).sort().map((key) => [key, filled[field][key]]));
      }
    }
    const ordered = {};
    for (const key of FIELD_ORDER) {
      if (Object.prototype.hasOwnProperty.call(filled, key)) ordered[key] = filled[key];
    }
    for (const [key, value] of Object.entries(filled)) {
      if (!Object.prototype.hasOwnProperty.call(ordered, key)) ordered[key] = value;
    }
    return ordered;
  });
}

// Drop what has nothing to say, throughout the report. Absent is not
// unknown here, it is nothing to say: no site means the document as a
// whole, no document means the schema given on the command line, and an
// empty constraint or particulars is a pair of braces a reader must look
// inside to learn was empty. `branch` is scaffolding for the grouping above,
// and `nameChecked` for withFound, and neither reaches the file.
function tidy(errors) {
  return errors.map((entry) => {
    const pruned = {};
    for (const [key, value] of Object.entries(entry)) {
      if (key === 'keyword' && value === null) continue;
      if (key === 'site' && value.length === 0) continue;
      if (key === 'document' && value === null) continue;
      if ((key === 'constraint' || key === 'particulars')
          && Object.keys(value).length === 0) continue;
      if (key === 'branch' || key === 'nameChecked') continue;
      pruned[key] = key === 'rejections'
        ? value.map(({ branch, ...rest }) => ({ ...rest, errors: tidy(rest.errors) }))
        : value;
    }
    return pruned;
  });
}

// An array of scalars short enough to read at a glance goes on one line;
// everything else indents. Only the layout is ours -- every scalar still
// goes through JSON.stringify, so escaping and number formatting stay
// identical to the other leg's for free. The separator is written out
// because the two languages disagree by default: Python writes ", "
// between elements and JavaScript writes ",".
const INLINE_WIDTH = 72;

function render(value, indent = 0) {
  const pad = ' '.repeat(indent);
  if (Array.isArray(value)) {
    if (value.length === 0) return '[]';
    if (value.every((item) => item === null || typeof item !== 'object')) {
      const inline = `[${value.map((item) => JSON.stringify(item)).join(', ')}]`;
      if (inline.length + indent <= INLINE_WIDTH) return inline;
    }
    const items = value.map((item) => `${pad}  ${render(item, indent + 2)}`);
    return `[\n${items.join(',\n')}\n${pad}]`;
  }
  if (value !== null && typeof value === 'object') {
    const entries = Object.entries(value);
    if (entries.length === 0) return '{}';
    const items = entries.map(([key, item]) =>
      `${pad}  ${JSON.stringify(key)}: ${render(item, indent + 2)}`);
    return `{\n${items.join(',\n')}\n${pad}}`;
  }
  return JSON.stringify(value);
}

function writeOutput(destination, text) {
  if (destination === '-') {
    process.stdout.write(text);
    return;
  }
  try {
    fs.writeFileSync(destination, text);
  } catch (e) {
    die(`cannot write ${destination}: ${e.message}`);
  }
}

function emit(opts, valid, lines, errors) {
  if (opts.text !== undefined) {
    writeOutput(opts.text, (valid ? ['VALID'] : lines).map((l) => `${l}\n`).join(''));
  }
  if (opts.json !== undefined) {
    writeOutput(opts.json, `${render({ valid, errors })}\n`);
  }
  return valid ? EXIT_VALID : EXIT_INVALID;
}

// Honor or refuse a schema's declared JSON Schema version. A top-level
// "$schema" entry naming any version other than 2020-12 is refused (exit
// 2): the declaration states which semantics the schema was written for,
// and validating under other semantics can silently change its meaning (a
// draft-07 author's "definitions" and "dependencies" are ignored unknown
// members under 2020-12). With ignoreDeclared, the declaration is
// discarded and the schema validates as 2020-12 anyway -- the same
// reinterpretation, but as an explicit choice. Declaring 2020-12, or
// declaring nothing, passes through untouched.
function checkDeclaredVersion(schema, path, ignoreDeclared) {
  if (typeof schema !== 'object' || schema === null || !('$schema' in schema)) return;
  const declared = schema.$schema;
  if (declared === SUPPORTED_VERSION_URI) return;
  if (ignoreDeclared) {
    delete schema.$schema;
    return;
  }
  die(`${path} declares JSON Schema version ${JSON.stringify(declared)}; ` +
      `only 2020-12 is supported (pass --ignore-declared-version to ` +
      `validate it as 2020-12 anyway)`);
}

// Collect every duplicate object member name in a JSON text. JSON.parse
// silently keeps the last value for a repeated name, so duplicates must be
// found by scanning the raw text; the caller guarantees the text has already
// parsed as JSON, which is what keeps this walk simple. Escape sequences in
// member names are decoded so "a" and "a" collide, matching what
// JSON.parse would treat as the same member.
function findDuplicateMembers(text) {
  const duplicates = new Set();
  let i = 0;
  const ESCAPES = { '"': '"', '\\': '\\', '/': '/', b: '\b', f: '\f', n: '\n', r: '\r', t: '\t' };
  const skipWs = () => { while (' \t\n\r'.includes(text[i])) i++; };
  function scanString() {
    i++;  // opening quote
    let s = '';
    while (text[i] !== '"') {
      if (text[i] === '\\') {
        if (text[i + 1] === 'u') { s += String.fromCharCode(parseInt(text.slice(i + 2, i + 6), 16)); i += 6; }
        else { s += ESCAPES[text[i + 1]]; i += 2; }
      } else { s += text[i]; i++; }
    }
    i++;  // closing quote
    return s;
  }
  function scanValue() {
    skipWs();
    if (text[i] === '{') { scanObject(); return; }
    if (text[i] === '[') { scanArray(); return; }
    if (text[i] === '"') { scanString(); return; }
    while (i < text.length && !',}] \t\n\r'.includes(text[i])) i++;  // number/true/false/null
  }
  function scanObject() {
    i++;  // '{'
    const seen = new Set();
    skipWs();
    if (text[i] === '}') { i++; return; }
    for (;;) {
      skipWs();
      const name = scanString();
      if (seen.has(name)) duplicates.add(name);
      seen.add(name);
      skipWs();
      i++;  // ':'
      scanValue();
      skipWs();
      if (text[i] === ',') { i++; continue; }
      i++;  // '}'
      return;
    }
  }
  function scanArray() {
    i++;  // '['
    skipWs();
    if (text[i] === ']') { i++; return; }
    for (;;) {
      scanValue();
      skipWs();
      if (text[i] === ',') { i++; continue; }
      i++;  // ']'
      return;
    }
  }
  scanValue();
  return duplicates;
}

function main() {
  const opts = parseCli();
  const schema = loadJson(opts.schema, 'schema');
  checkDeclaredVersion(schema, opts.schema, opts['ignore-declared-version']);
  const instanceText = readText(opts.instance, 'instance');

  // Ajv's own notices (e.g. an unknown format being ignored) go through its
  // logger, which by default writes them unprefixed and can repeat one notice
  // several times for a single schema. Route them through the same
  // `prog: level: message` shape as our other diagnostics, and collapse
  // duplicates -- the same treatment the invalid-schema clauses get below.
  const announced = new Set();
  const notice = (level) => (...parts) => {
    const message = parts.join(' ');
    if (announced.has(message)) return;
    announced.add(message);
    process.stderr.write(`${PROG}: ${level}: ${message}\n`);
  };
  const logger = { log: notice('note'), warn: notice('warning'), error: notice('error') };

  // strict: false has Ajv ignore keywords it does not know, which is what
  // the standard says to do with them and what lets errorMessage ride in a
  // schema as data: the wrapper reads it out of the schema itself, below,
  // rather than through Ajv.
  //
  // validateFormats: false makes "format" a pure annotation on this leg,
  // silently, matching the Python leg (which has no format checker
  // attached). Without it Ajv warns that each format is "unknown" and
  // ignored -- true only because its format definitions live in an add-on
  // this wrapper does not load, and misleading when ignoring is all the
  // wrapper ever does. Format assertion, if added, is added to both legs
  // together, as an explicit option.
  // verbose attaches parentSchema to every error: the subschema object the
  // failing keyword sits in. Located by identity that is exact, where Ajv's
  // own schemaPath is a string it composes -- and one it gets wrong for a
  // recursive $ref, reporting #/required for a keyword that is nowhere near
  // the root.
  const ajv = new Ajv2020({
    allErrors: true, strict: false, validateFormats: false, verbose: true, logger,
  });
  const refSchemas = {};
  for (const path of opts.ref ?? []) {
    const refSchema = loadJson(path, 'ref schema');
    checkDeclaredVersion(refSchema, path, opts['ignore-declared-version']);
    if (typeof refSchema !== 'object' || refSchema === null || !refSchema.$id) {
      die(`ref schema file ${path} has no $id to register it under`);
    }
    try {
      ajv.addSchema(refSchema);
    } catch (e) {
      die(`${path} is not a valid JSON Schema: ${e.message}`);
    }
    refSchemas[refSchema.$id] = refSchema;
  }
  let validate;
  try {
    validate = ajv.compile(schema);
  } catch (e) {
    const clauses = e.message.replace(/^schema is invalid:\s*/, '').split(', ');
    die(`${opts.schema} is not a valid JSON Schema: ${[...new Set(clauses)].join(', ')}`);
  }

  // The instance's parse failure is a verdict, not an error: a document that
  // was delivered but does not parse is invalid at the lowest grammar tier --
  // JSON itself -- reported with a uniform first phrase, the parser's own
  // detail riding behind it like any other library message. Only failing to
  // read the file at all is operational: everything about the instance is a
  // verdict; everything else is an error. Parsed only after the schema has
  // been vetted, so a broken setup still exits 2.
  let instance;
  try {
    instance = JSON.parse(instanceText);
  } catch (e) {
    const message = `instance is not valid JSON: ${e.message}`;
    return emit(opts, false, [`INVALID: ${message}`],
                [{ keyword: 'parse', message }]);
  }

  // Like the parse verdict above: a duplicate member name is a fact about
  // the submitted document, reported deterministically (all names, sorted)
  // so the flag's output is cross-validated word for word with
  // jsonschema-validate.
  if (opts['reject-duplicate-members']) {
    const duplicates = findDuplicateMembers(instanceText);
    if (duplicates.size > 0) {
      const names = [...duplicates].sort();
      return emit(
        opts, false,
        names.map((name) => `INVALID: instance contains duplicate member name ${JSON.stringify(name)}`),
        names.map((name) => ({
          keyword: 'duplicateMember', particulars: { memberName: name },
          message: `instance contains duplicate member name ${JSON.stringify(name)}`,
        })),
      );
    }
  }

  if (validate(instance)) return emit(opts, true, [], []);

  // The text form is built from Ajv's errors exactly as it always was, so
  // that what a caller has always got is unaffected by anything the JSON
  // form decides. The two answer different questions: what this library
  // said, and what the two legs agree happened.
  const index = indexDocuments(schema, Object.values(refSchemas));
  const errors = validate.errors.map((err) => ({
    ...err, message: authoredMessage(err, schema, instance, index) ?? err.message,
  }));
  const lines = errors.map((err) => {
    const loc = err.instancePath || '/';
    return loc === '/' ? `INVALID: ${err.message}` : `INVALID: ${loc}: ${err.message}`;
  });
  return emit(opts, false, lines,
              tidy(withFound(
                errorsFrom(errors, instance, schema, index,
                           indexSubschemas(schema, Object.values(refSchemas))),
                instance)));
}

process.exit(main());
