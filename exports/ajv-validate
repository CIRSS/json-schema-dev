#!/usr/bin/env node
// Validate a JSON instance against a JSON Schema, at the 2020-12 dialect.
//
// Usage: ajv-validate --schema FILE --instance FILE [--ref FILE]...
//
// Arguments are named, not positional, so the schema and instance cannot be
// swapped by accident. Uses Ajv's 2020-12 build so the verdict is directly
// comparable with jsonschema-validate. Each --ref FILE loads an additional
// schema and registers it under its $id, making it available to $ref in the
// main schema -- this is how a schema spread over several files is validated
// against. A --ref schema must carry a $id; there is nothing else to register
// it under. The verdict is written to stdout as `VALID` or one `INVALID: ...`
// line per error; diagnostics go to stderr. Exit status:
//
//     0  the instance is valid
//     1  the instance is invalid
//     2  error (bad arguments, unreadable file, malformed JSON, invalid
//        schema, a --ref schema without $id)
'use strict';

const fs = require('fs');
const { parseArgs } = require('node:util');
const Ajv2020Module = require('ajv/dist/2020');
const Ajv2020 = Ajv2020Module.default || Ajv2020Module;
const ajvErrorsModule = require('ajv-errors');
const ajvErrors = ajvErrorsModule.default || ajvErrorsModule;

const PROG = 'ajv-validate';
const USAGE = `usage: ${PROG} --schema FILE --instance FILE [--ref FILE]...`;
const EXIT_VALID = 0;
const EXIT_INVALID = 1;
const EXIT_ERROR = 2;

function die(message) {
  process.stderr.write(`${PROG}: error: ${message}\n`);
  process.exit(EXIT_ERROR);
}

function loadJson(path, role) {
  let text;
  try {
    text = fs.readFileSync(path, 'utf8');
  } catch (e) {
    if (e.code === 'ENOENT') die(`${role} file not found: ${path}`);
    if (e.code === 'EISDIR') die(`${role} path is a directory: ${path}`);
    die(`cannot read ${role} file ${path}: ${e.message}`);
  }
  try {
    return JSON.parse(text);
  } catch (e) {
    die(`${role} file ${path} is not valid JSON: ${e.message}`);
  }
}

function parseCli() {
  let values;
  try {
    ({ values } = parseArgs({
      args: process.argv.slice(2),
      options: {
        schema: { type: 'string', short: 's' },
        instance: { type: 'string', short: 'i' },
        ref: { type: 'string', short: 'r', multiple: true },
        help: { type: 'boolean', short: 'h' },
      },
      allowPositionals: false,
    }));
  } catch (e) {
    process.stderr.write(`${PROG}: error: ${e.message}\n${USAGE}\n`);
    process.exit(EXIT_ERROR);
  }
  if (values.help) {
    process.stdout.write(USAGE + '\n');
    process.exit(EXIT_VALID);
  }
  if (!values.schema || !values.instance) {
    process.stderr.write(`${PROG}: error: both --schema and --instance are required\n${USAGE}\n`);
    process.exit(EXIT_ERROR);
  }
  return values;
}

function main() {
  const opts = parseCli();
  const schema = loadJson(opts.schema, 'schema');
  const instance = loadJson(opts.instance, 'instance');

  // Ajv's own notices (e.g. an unknown format being ignored) go through its
  // logger, which by default writes them unprefixed and can repeat one notice
  // several times for a single schema. Route them through the same
  // `prog: level: message` shape as our other diagnostics, and collapse
  // duplicates -- the same treatment the invalid-schema clauses get below.
  const announced = new Set();
  const notice = (level) => (...parts) => {
    const message = parts.join(' ');
    if (announced.has(message)) return;
    announced.add(message);
    process.stderr.write(`${PROG}: ${level}: ${message}\n`);
  };
  const logger = { log: notice('note'), warn: notice('warning'), error: notice('error') };

  // ajv-errors registers the (nonstandard) errorMessage keyword: a schema
  // author's message replaces the library's for failures it covers. The
  // matching lookup is implemented independently in jsonschema-validate, so
  // authored messages are cross-validated like verdicts (demo 16).
  const ajv = new Ajv2020({ allErrors: true, strict: false, logger });
  ajvErrors(ajv);
  for (const path of opts.ref ?? []) {
    const refSchema = loadJson(path, 'ref schema');
    if (typeof refSchema !== 'object' || refSchema === null || !refSchema.$id) {
      die(`ref schema file ${path} has no $id to register it under`);
    }
    try {
      ajv.addSchema(refSchema);
    } catch (e) {
      die(`${path} is not a valid JSON Schema: ${e.message}`);
    }
  }
  let validate;
  try {
    validate = ajv.compile(schema);
  } catch (e) {
    const clauses = e.message.replace(/^schema is invalid:\s*/, '').split(', ');
    die(`${opts.schema} is not a valid JSON Schema: ${[...new Set(clauses)].join(', ')}`);
  }

  if (validate(instance)) {
    process.stdout.write('VALID\n');
    return EXIT_VALID;
  }
  for (const err of validate.errors) {
    const loc = err.instancePath || '/';
    process.stdout.write(loc === '/' ? `INVALID: ${err.message}\n`
                                     : `INVALID: ${loc}: ${err.message}\n`);
  }
  return EXIT_INVALID;
}

process.exit(main());
