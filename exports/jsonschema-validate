#!/usr/bin/env python3
"""Validate a JSON instance against a JSON Schema, at the 2020-12 dialect.

Usage: jsonschema-validate --schema FILE --instance FILE [--ref FILE]...
                           [--reject-duplicate-members]
                           [--ignore-declared-version]
                           [--text FILE|-] [--json FILE|-]

Arguments are named, not positional, so the schema and instance cannot be
swapped by accident. The 2020-12 dialect is forced regardless of the schema's
own $schema, so the verdict is directly comparable with ajv-validate. Each
--ref FILE loads an additional schema and registers it under its $id, making
it available to $ref in the main schema — this is how a schema spread over
several files is validated against. A --ref schema must carry a $id; there is
nothing else to register it under. --reject-duplicate-members makes a
duplicate object member name anywhere in the instance an INVALID verdict:
JSON's grammar permits duplicates but parsers silently keep the last value,
so no schema can ever see one -- parse time is the only tier that can check.
A schema (or ref schema) whose top-level "$schema" entry names any version
other than 2020-12 is refused (exit 2): validating it under 2020-12
semantics could silently change its meaning. --ignore-declared-version
overrides the refusal by discarding the declaration and validating as
2020-12 anyway -- an explicit choice, never a silent one.
The verdict has two forms, and a run may ask for either or both: --text
writes the lines a caller has always got, `VALID` or one `INVALID: ...` per
error, and --json writes a report carrying each finding's location as
segments, the keyword that failed, where that keyword lives, and the
identity of what offended. Either takes a file, or - for stdout; passing
neither writes the text form to stdout. Diagnostics go to stderr. Exit
status:

    0  the instance is valid
    1  the instance is invalid -- including an instance file that is not
       valid JSON: the parse failure is a verdict about the submitted
       document (its lowest grammar tier), not an operational error
    2  error (bad arguments, unreadable file, schema or ref file with
       malformed JSON, invalid schema, unresolvable $ref, a --ref schema
       without $id)
"""
import argparse
import collections
import json
import re
import sys

from jsonschema import Draft202012Validator
from jsonschema._utils import find_evaluated_property_keys_by_schema
from jsonschema.exceptions import SchemaError, _WrappedReferencingError
from referencing import Registry, Resource
from referencing.jsonschema import DRAFT202012

PROG = "jsonschema-validate"
EXIT_VALID, EXIT_INVALID, EXIT_ERROR = 0, 1, 2
SUPPORTED_VERSION_URI = "https://json-schema.org/draft/2020-12/schema"
# A $ref chain longer than this is a cycle, and a location is not worth
# hanging for.
MAX_REF_DEPTH = 32
COMMAND_LINE_SCHEMA = "the schema given on the command line"


def die(message):
    print(f"{PROG}: error: {message}", file=sys.stderr)
    sys.exit(EXIT_ERROR)


def load_json(path, role):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        die(f"{role} file not found: {path}")
    except IsADirectoryError:
        die(f"{role} path is a directory: {path}")
    except OSError as e:
        die(f"cannot read {role} file {path}: {e.strerror}")
    except json.JSONDecodeError as e:
        die(f"{role} file {path} is not valid JSON: {e}")


def check_declared_version(schema, path, ignore_declared):
    """Honor or refuse a schema's declared JSON Schema version.

    A top-level "$schema" entry naming any version other than 2020-12 is
    refused (exit 2): the declaration is the author's statement of which
    semantics the schema was written for, and validating it under other
    semantics can silently change its meaning (a draft-07 author's
    "definitions" and "dependencies" are ignored unknown members under
    2020-12). With ignore_declared, the declaration is discarded and the
    schema is validated as 2020-12 anyway -- the same reinterpretation,
    but as an explicit choice. Declaring 2020-12, or declaring nothing,
    passes through untouched.
    """
    if not isinstance(schema, dict) or "$schema" not in schema:
        return
    declared = schema["$schema"]
    if declared == SUPPORTED_VERSION_URI:
        return
    if ignore_declared:
        del schema["$schema"]
        return
    die(f"{path} declares JSON Schema version "
        f"{json.dumps(declared, ensure_ascii=False)}; only 2020-12 is "
        f"supported (pass --ignore-declared-version to validate it as "
        f"2020-12 anyway)")


def read_instance_text(path):
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        die(f"instance file not found: {path}")
    except IsADirectoryError:
        die(f"instance path is a directory: {path}")
    except OSError as e:
        die(f"cannot read instance file {path}: {e.strerror}")


def parse_instance(text, reject_duplicates):
    """Parse the instance, treating a parse failure as a verdict.

    A document that was delivered but does not parse is invalid at the
    lowest grammar tier -- JSON itself -- so the wrapper reports INVALID
    (exit 1) with a uniform first phrase, the parser's own detail riding
    behind it like any other library message. Only failing to read the
    file at all is an operational error: everything about the instance is
    a verdict; everything else is an error. The verdict is issued only
    after the schema has been vetted, so a broken setup still exits 2.

    With reject_duplicates, a duplicate object member name anywhere in the
    instance is likewise a verdict. All duplicate names are collected,
    deduplicated, and reported sorted, one line per name -- a deterministic
    order shared with ajv-validate (whose scanner visits objects in textual
    order where this hook visits them innermost-first), so the flag's
    output is cross-validated word for word.
    """
    duplicates = set()

    def note_duplicates(pairs):
        seen = set()
        obj = {}
        for key, value in pairs:
            if key in seen:
                duplicates.add(key)
            seen.add(key)
            obj[key] = value
        return obj

    try:
        instance = json.loads(
            text, object_pairs_hook=note_duplicates if reject_duplicates else None)
    except json.JSONDecodeError as e:
        return None, [{"keyword": "parse",
                       "message": f"instance is not valid JSON: {e}"}]
    if duplicates:
        # ensure_ascii=False so a non-ASCII name prints byte-identically with
        # ajv-validate's JSON.stringify, keeping the line cross-validated.
        return instance, [
            {"keyword": "duplicateMember",
             "particulars": {"memberName": name},
             "message": "instance contains duplicate member name "
                        f"{json.dumps(name, ensure_ascii=False)}"}
            for name in sorted(duplicates)
        ]
    return instance, []


def location(error):
    return "/" + "/".join(str(p) for p in error.absolute_path)


def enclosing_schemas(error, schema):
    """The subschemas around a failing keyword, innermost first.

    The innermost is error.schema, the subschema the validator was applying
    when the keyword failed. It has to be taken from the error rather than
    found by walking, because a $ref is followed without leaving any trace
    in absolute_schema_path: for a keyword inside a definition applied by
    reference, the path names the referring member and stops there, so no
    walk from the root reaches the definition at all.

    The rest are recovered by walking that path from the root, which gives
    the enclosing subschemas in the referring document. A prefix that does
    not resolve is skipped rather than ending the walk -- inside a $ref'd
    definition the deeper prefixes are exactly the ones that do not resolve,
    and the shallower ones are still real enclosing schemas.
    """
    yield error.schema
    path = list(error.absolute_schema_path)
    for depth in range(len(path), -1, -1):
        node = schema
        try:
            for segment in path[:depth]:
                node = node[segment]
        except (KeyError, IndexError, TypeError):
            continue
        yield node


def custom_message(error, schema):
    """The message from the nearest enclosing errorMessage, if any.

    errorMessage is a nonstandard keyword (Ajv's ajv-errors plugin defines
    it) that the jsonschema library ignores -- but a schema is JSON, so the
    messages are data this wrapper can read for itself. Supported here is the
    portable subset cross-validated by demo 19: a plain-string errorMessage
    covers every failure within its subschema, an object supplies one message
    per failing keyword, and ${/json/pointer} interpolates the instance value
    at that pointer (JSON-encoded, resolved from the instance root, matching
    ajv-errors). Failures no message covers keep the library's own message.

    A message stated with a factored-out definition therefore covers failures
    of that definition wherever it is applied, and beats one written beside
    the $ref, the definition being the nearer of the two.
    """
    for node in enclosing_schemas(error, schema):
        if not isinstance(node, dict):
            continue
        declared = node.get("errorMessage")
        if isinstance(declared, str):
            return declared
        if isinstance(declared, dict):
            message = declared.get(error.validator)
            if isinstance(message, str):
                return message
    return None


def interpolate(message, instance, error_path):
    """Replace each ${pointer} with the instance value it points at.

    Two pointer forms, matching ajv-errors. An absolute JSON Pointer
    (${/artifacts/0}; RFC 6901, with ~0/~1 escapes) resolves from the
    instance root — a fixed address, useful only where the schema knows the
    exact location. A relative JSON Pointer (${0}, ${1/digest}) resolves
    from the failing value's own location: the integer climbs that many
    levels up from it, and an optional path descends from there — so ${0}
    is the failing value itself, wherever it occurs. Values are
    JSON-encoded. A pointer that does not resolve (including the unsupported
    trailing-# form) is left in the message as written.
    """
    def descend(node, pointer):
        for token in pointer.lstrip("/").split("/") if pointer else []:
            token = token.replace("~1", "/").replace("~0", "~")
            node = node[int(token)] if isinstance(node, list) else node[token]
        return node

    def replace(match):
        pointer = match.group(1)
        try:
            if pointer.startswith("/") or pointer == "":
                return json.dumps(descend(instance, pointer))
            relative = re.fullmatch(r"(0|[1-9][0-9]*)(/.*)?", pointer)
            if relative:
                up = int(relative.group(1))
                if up > len(error_path):
                    return match.group(0)
                node = instance
                for segment in list(error_path)[:len(error_path) - up]:
                    node = node[segment]
                return json.dumps(descend(node, relative.group(2) or ""))
        except (KeyError, IndexError, TypeError, ValueError):
            pass
        return match.group(0)
    return re.sub(r"\$\{([^}]*)\}", replace, message)


# Keywords whose failure states that some subschema failed, rather than
# stating anything about the instance. python-jsonschema does not report
# most of them at all -- it descends and yields the inner failure -- so this
# set exists to keep the two legs describing one thing, and is checked here
# for the few it can report.
TRANSPARENT_KEYWORDS = frozenset({
    "if", "then", "else", "$ref", "properties", "patternProperties",
    "additionalProperties", "unevaluatedProperties", "propertyNames",
    "items", "prefixItems", "allOf", "dependentSchemas", "unevaluatedItems",
})

# The two keywords above that are assertions rather than applicators when
# their value is false: each rejects members, and each gets one finding per
# member rejected, located at it.
MEMBER_REJECTING = frozenset({"additionalProperties", "unevaluatedProperties"})
PARAM_FOR_MEMBER = {"additionalProperties": "additionalProperty",
                    "unevaluatedProperties": "unevaluatedProperty"}

# Keywords whose failure is a conclusion about subschemas that were tried,
# with the reasons underneath it. These do carry a finding: the reasons are
# the only place the detail exists.
BRANCHING_KEYWORDS = frozenset({"anyOf", "oneOf", "contains", "not"})

# Keywords whose "params" is the keyword's own value under a canonical name.
# Ajv reports these natively; here validator_value carries the same fact.
VALUE_PARAM = {
    "enum": "allowedValues",
    "const": "allowedValue",
    "type": "type",
    "pattern": "pattern",
    "multipleOf": "multipleOf",
    "maxLength": "limit", "minLength": "limit",
    "maximum": "limit", "minimum": "limit",
    "exclusiveMaximum": "limit", "exclusiveMinimum": "limit",
    "maxItems": "limit", "minItems": "limit",
    "maxProperties": "limit", "minProperties": "limit",
}


# Which of a keyword's params state what the schema demanded, as against
# the particulars of the violation. Across every keyword handled here the
# two never both apply -- a keyword reports one kind or the other -- so the
# split works out as a tag on which kind this keyword carries.
CONSTRAINT_PARAMS = frozenset({
    "allowedValues", "allowedValue", "type", "pattern", "multipleOf",
    "limit", "minContains",
})


def split_params(error, seen):
    """The keyword's demand and the violation's particulars, separately."""
    params = offender_params(error, seen)
    return ({k: v for k, v in params.items() if k in CONSTRAINT_PARAMS},
            {k: v for k, v in params.items() if k not in CONSTRAINT_PARAMS})


def offender_params(error, seen):
    """The identity of what actually offended, as fields rather than prose.

    Ajv carries this in err.params; python-jsonschema carries none of it, so
    it is recomputed here from the failing value and the keyword's own value.
    The report has to identify the source of an error unambiguously, and a
    message naming the offender in prose does not.

    `seen` counts errors already emitted for one keyword at one location, so
    that "required" -- which yields one indistinguishable error per missing
    member -- can be paired with the missing members in the order the library
    yields them.
    """
    keyword, value = error.validator, error.validator_value
    if keyword in VALUE_PARAM:
        return {VALUE_PARAM[keyword]: value}
    if keyword == "required" and isinstance(error.instance, dict):
        # Keyed by where the keyword is as well as where the instance is: two
        # "required" keywords under one allOf fail at the same location, and
        # counting them together pairs the second with the first one's list.
        missing = [name for name in value if name not in error.instance]
        key = (tuple(error.absolute_path), tuple(error.absolute_schema_path))
        index = seen[key]
        seen[key] += 1
        if index < len(missing):
            return {"missingProperty": missing[index]}
        return {}
    if keyword == "uniqueItems" and isinstance(error.instance, list):
        for j, earlier in enumerate(error.instance):
            for i in range(j + 1, len(error.instance)):
                if error.instance[i] == earlier:
                    return {"i": i, "j": j}
        return {}
    if keyword == "oneOf":
        return {"passingSchemas": passing_schemas(error)}
    if keyword == "contains":
        return {"minContains": error.schema.get("minContains", 1)
                if isinstance(error.schema, dict) else 1}
    return {}


def passing_schemas(error):
    """Which oneOf branches matched, for a failure of matching more than one.

    A oneOf that failed because nothing matched has no passing branches, and
    the library says so by giving the error a context; one that failed
    because several matched has no context, and the branches have to be
    found by trying them.
    """
    if error.context:
        return None
    branches = error.validator_value
    passing = [index for index, branch in enumerate(branches)
               if Draft202012Validator(branch).is_valid(error.instance)]
    return passing or None


def extra_members(error, validator):
    """The members an "additionalProperties" or "unevaluatedProperties"
    false actually rejected.

    Reported as one finding per member, located at the member, where both
    libraries report at the parent -- Ajv once per member, python once for
    all of them. Neither locates the member it is talking about.

    Which members count as unevaluated is not something a reader of the
    schema can work out, since it depends on what every applicator alongside
    the keyword annotated; the library computes it to raise the error at all,
    and the same computation is used here rather than a second guess at it.
    """
    if error.validator_value is not False or not isinstance(error.instance, dict):
        return None
    if not isinstance(error.schema, dict):
        return None
    if error.validator == "unevaluatedProperties":
        evaluated = find_evaluated_property_keys_by_schema(
            validator, error.instance, error.schema)
        return [name for name in error.instance if name not in evaluated]
    declared = error.schema.get("properties", {})
    patterns = error.schema.get("patternProperties", {})
    return [name for name in error.instance
            if name not in declared
            and not any(re.search(p, name) for p in patterns)]


def pointer_segments(document, pointer):
    """A JSON Pointer into a schema document, as typed segments.

    Typed the same way an instance path is: standing on an array makes the
    segment an index, standing on an object makes it a member name. A schema
    has both -- "anyOf/0" indexes a list where "properties/anyOf" would name
    a member -- so a rendered pointer is no less ambiguous here than it is
    over an instance.
    """
    segments, node = [], document
    for raw in pointer.split("/")[1:] if pointer else []:
        token = raw.replace("~1", "/").replace("~0", "~")
        segment = int(token) if isinstance(node, list) else token
        segments.append(segment)
        node = node[segment]
    return segments


def lost(error, detail):
    """A clause we cannot locate is a defect in this program, not a verdict.

    Reporting a plausible partial location would put a place in the report
    that the keyword is not at, which is the one thing the report exists to
    prevent. So the run stops and says so.
    """
    die(f"cannot locate the {error.validator} keyword that failed at "
        f"/{'/'.join(str(p) for p in error.absolute_path)}: {detail}")


def index_documents(schema, refs):
    """Every name a $ref can use, mapped to a document and a path into it.

    A schema names parts of itself two ways: an $id on a subschema, which
    makes it a resource in its own right, and an $anchor, which names a spot
    without making one. Both are navigation aids rather than report
    coordinates: a clause is always reported as a path from the root of a
    document the caller handed over, because that is the file a reader has.

    Keys are what a $ref can say -- "#" and "#anchor" for the schema on the
    command line, an $id for anything that has one, and "<$id>#anchor" for an
    anchor inside it. Values are (document, path from that document's root).
    """
    index = {}

    def walk(node, document, base, path):
        if isinstance(node, list):
            for i, item in enumerate(node):
                walk(item, document, base, path + [i])
            return
        if not isinstance(node, dict):
            return
        identifier = node.get("$id")
        if isinstance(identifier, str) and path:
            base = identifier
            index[identifier] = (document, path)
        anchor = node.get("$anchor")
        if isinstance(anchor, str):
            index[f"{base or ''}#{anchor}"] = (document, path)
        for key, item in node.items():
            walk(item, document, base, path + [key])

    index["#"] = (schema, [])
    walk(schema, schema, None, [])
    for ref in refs:
        identifier = ref.get("$id") if isinstance(ref, dict) else None
        if identifier:
            index[identifier] = (ref, [])
        walk(ref, ref, identifier, [])
    return index


def resolve_ref(reference, base, document, base_path, index, error):
    """Where a $ref leads: a document, a path from its root, and the resource
    that path is now inside.

    A "#/pointer" is read from the root of the enclosing **resource**, not
    from wherever the reference was written, so the resource has to be
    carried alongside the path rather than inferred from it.
    """
    uri, _, fragment = reference.partition("#")
    if not uri:
        if fragment.startswith("/") or fragment == "":
            return (document,
                    base_path + pointer_segments_at(document, base_path, fragment, error),
                    base, base_path)
        key = f"{base or ''}#{fragment}"
        if key not in index:
            lost(error, f"{reference} names nothing this run was given")
        target, target_path = index[key]
        return target, target_path, base, base_path
    key = uri
    if key not in index:
        lost(error, f"{reference} names nothing this run was given")
    target, resource_path = index[key]
    if fragment.startswith("/"):
        return (target,
                resource_path + pointer_segments_at(target, resource_path, fragment, error),
                uri, resource_path)
    if fragment:
        anchored = f"{uri}#{fragment}"
        if anchored not in index:
            lost(error, f"{reference} names nothing this run was given")
        target, target_path = index[anchored]
        return target, target_path, uri, resource_path
    return target, resource_path, uri, resource_path


def pointer_segments_at(document, prefix, pointer, error):
    """A pointer read from a subschema rather than from the document root."""
    node = document
    for step in prefix:
        node = node[step]
    try:
        return pointer_segments(node, pointer)
    except (KeyError, IndexError, TypeError, ValueError):
        lost(error, f"{pointer} points nowhere below {prefix}")


def rule_location(error, schema, index):
    """Where the failing keyword lives: which document, and where in it.

    A finding has to be traceable to the rule that produced it, and the
    library does not report one: python-jsonschema follows a $ref without
    recording it, so absolute_schema_path names the referring member and
    stops there -- for a keyword inside a definition applied by reference it
    describes a place the keyword is not. The route is walked here instead,
    resolving a $ref wherever the path continues into something the current
    node does not contain.
    """
    document, base, base_path = schema, None, []
    segments, node = [], schema
    for segment in error.absolute_schema_path:
        depth = 0
        while (isinstance(node, dict) and "$ref" in node
               and segment not in node and depth < MAX_REF_DEPTH):
            document, segments, base, base_path = resolve_ref(
                node["$ref"], base, document, base_path, index, error)
            node = document
            for step in segments:
                node = node[step]
            depth += 1
        try:
            node = node[segment]
        except (KeyError, IndexError, TypeError):
            lost(error, f"the path leaves the schema at {segment!r}")
        segments = segments + [segment]
    return {"document": document_name(document, schema, index), "path": segments}


def document_name(document, schema, index):
    """None for the schema given on the command line, its $id otherwise."""
    if document is schema:
        return None
    return document.get("$id") if isinstance(document, dict) else None


def clause_of(error, schema, index):
    return rule_location(error, schema, index)["path"]


def document_of(error, schema, index):
    return rule_location(error, schema, index)["document"]


def with_prefix(errors, site_prefix, clause_prefix):
    """Re-root errors computed against a subschema in their own right.

    A recomputed error knows where it sits inside the subschema it was
    checked against, and nothing about where that subschema sits, so both
    of its locations need the enclosing keyword's own in front of them.
    """
    for entry in errors:
        entry["site"] = list(site_prefix) + entry["site"]
        entry["clause"] = list(clause_prefix) + entry["clause"]
        for rejection in entry.get("rejections", []):
            if "clause" in rejection:
                rejection["clause"] = list(clause_prefix) + rejection["clause"]
            if "site" in rejection:
                rejection["site"] = list(site_prefix) + rejection["site"]
            with_prefix(rejection["errors"], site_prefix, clause_prefix)
    return errors


def contains_rejections(error, validator, schema, instance, index):
    """Why each element failed the schema "contains" asked for.

    python-jsonschema gives a contains failure no context: it counts matches
    and reports the count, so the reasons the elements did not match are
    never built. They are the only place that detail exists, so they are
    recomputed here -- by evolving the root validator, which keeps the
    resolution scope, so a $ref inside the subschema still resolves against
    the document it was written in.

    Each element is one rejection, since an element that had matched would
    have satisfied the clause on its own.
    """
    if not isinstance(error.instance, list):
        return []
    subschema = validator.evolve(schema=error.validator_value)
    clause = clause_of(error, schema, index)
    site = list(error.absolute_path)
    rejections = []
    for index, item in enumerate(error.instance):
        errors = with_prefix(
            errors_from(sorted(subschema.iter_errors(item),
                               key=lambda e: list(e.absolute_path)),
                        error.validator_value, instance, subschema, index),
            site + [index], clause)
        if errors:
            rejections.append({"site": site + [index], "errors": errors})
    return rejections


def branch_rejections(error, schema, instance, validator, index):
    """One rejection per branch tried, with the errors that were its grounds.

    The branch a context error came from is the first segment of its schema
    path relative to the applicator, which is how python-jsonschema records
    which subschema of anyOf or oneOf produced it.
    """
    clause = clause_of(error, schema, index)
    grouped = collections.OrderedDict()
    for cause in error.context or []:
        grouped.setdefault(list(cause.schema_path)[0], []).append(cause)
    return [{"clause": clause + [branch],
             "errors": errors_from(causes, schema, instance, validator, index)}
            for branch, causes in grouped.items()]


def error_entry(error, schema, instance, seen, validator, index):
    """One violation, with what was tried beneath it where the clause offered
    more than one way to be satisfied."""
    authored = custom_message(error, schema)
    constraint, particulars = split_params(error, seen)
    entry = {
        "site": list(error.absolute_path),
        "keyword": error.validator,
        "clause": clause_of(error, schema, index),
        "document": document_of(error, schema, index),
        "constraint": constraint,
        "particulars": particulars,
        "message": (interpolate(authored, instance, error.absolute_path)
                    if authored else error.message),
    }
    if error.validator in BRANCHING_KEYWORDS:
        rejections = (contains_rejections(error, validator, schema, instance, index)
                      if error.validator == "contains"
                      else branch_rejections(error, schema, instance, validator, index))
        if rejections:
            entry["rejections"] = rejections
    return entry


def errors_from(errors, schema, instance, validator, index):
    """The report's errors, one per violation.

    A transparent applicator contributes nothing: its conclusion repeats a
    location already reported. A false "additionalProperties" or
    "unevaluatedProperties" contributes one error per member it rejected,
    located at that member, rather than one at the parent naming several.
    """
    seen = collections.Counter()
    report = []
    for error in errors:
        if error.validator in TRANSPARENT_KEYWORDS:
            rejected = (extra_members(error, validator)
                        if error.validator in MEMBER_REJECTING else None)
            for name in rejected or []:
                report.append({
                    "site": list(error.absolute_path) + [name],
                    "keyword": error.validator,
                    "clause": clause_of(error, schema, index),
                    "document": document_of(error, schema, index),
                    "constraint": {},
                    "particulars": {PARAM_FOR_MEMBER[error.validator]: name},
                    "message": error.message,
                })
            continue
        report.append(error_entry(error, schema, instance, seen, validator, index))
    return report


def tidy(errors):
    """Drop what has nothing to say, throughout the report.

    Absent is not unknown here, it is nothing to say: no site means the
    document as a whole, no document means the schema given on the command
    line, and an empty constraint or particulars is a pair of braces a
    reader must look inside to learn was empty.
    """
    kept = []
    for entry in errors:
        pruned = {}
        for key, value in entry.items():
            if key == "site" and value == []:
                continue
            if key == "document" and value is None:
                continue
            if key in ("constraint", "particulars") and not value:
                continue
            if key == "rejections":
                value = [dict(r, errors=tidy(r["errors"])) for r in value]
            pruned[key] = value
        kept.append(pruned)
    return kept


def parse_args(argv):
    # argparse exits 0 on --help and 2 on a bad invocation, matching the
    # exit-status contract above.
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Validate a JSON instance against a JSON Schema (2020-12 dialect).",
    )
    parser.add_argument("-s", "--schema", required=True, metavar="FILE",
                        help="the JSON Schema file")
    parser.add_argument("-i", "--instance", required=True, metavar="FILE",
                        help="the JSON instance file")
    parser.add_argument("-r", "--ref", action="append", default=[], metavar="FILE",
                        help="an additional schema file, registered under its "
                             "$id and available to $ref (repeatable)")
    parser.add_argument("--reject-duplicate-members", action="store_true",
                        help="report a duplicate object member name anywhere "
                             "in the instance as an INVALID verdict")
    parser.add_argument("--ignore-declared-version", action="store_true",
                        help="discard a schema's declared JSON Schema "
                             "version and validate as 2020-12 anyway")
    parser.add_argument("--text", metavar="FILE",
                        help="write the verdict lines to FILE, or to stdout "
                             "for -; the default when neither --text nor "
                             "--json is given")
    parser.add_argument("--json", metavar="FILE",
                        help="write the verdict as a JSON report to FILE, or "
                             "to stdout for -")
    args = parser.parse_args(argv[1:])
    if args.text == "-" and args.json == "-":
        die("--text and --json cannot both write to stdout")
    if args.text is None and args.json is None:
        args.text = "-"
    return args


def load_ref_resources(paths, ignore_declared):
    """The registry entries, and the parsed documents for the clause index."""
    resources, documents = [], []
    for path in paths:
        contents = load_json(path, "ref schema")
        check_declared_version(contents, path, ignore_declared)
        if not isinstance(contents, dict) or "$id" not in contents:
            die(f"ref schema file {path} has no $id to register it under")
        documents.append(contents)
        resources.append(
            (contents["$id"],
             Resource.from_contents(contents, default_specification=DRAFT202012))
        )
    return resources, documents


def verdict_lines(errors, schema, instance):
    """The text form: one line per error, exactly as the library reported it.

    Built from the errors rather than from the findings, so that the text a
    caller has always got is unaffected by anything the JSON form decides.
    The two forms answer different questions -- what each library said, and
    what the two of them agree happened.
    """
    lines = []
    for error in errors:
        loc = location(error)
        declared = custom_message(error, schema)
        message = (interpolate(declared, instance, error.absolute_path)
                   if declared else error.message)
        lines.append(f"INVALID: {message}" if loc == "/"
                     else f"INVALID: {loc}: {message}")
    return lines


# An array of scalars short enough to read at a glance goes on one line;
# everything else indents. Only the layout is ours -- every scalar still
# goes through the standard serializer, so escaping and number formatting
# stay identical to the other leg's for free. The separators are set
# explicitly because the two languages disagree by default: Python writes
# ", " between elements and JavaScript writes ",".
INLINE_WIDTH = 72


def render(value, indent=0):
    pad = " " * indent
    if isinstance(value, list):
        if not value:
            return "[]"
        if all(not isinstance(item, (list, dict)) for item in value):
            inline = json.dumps(value, ensure_ascii=False, separators=(", ", ": "))
            if len(inline) + indent <= INLINE_WIDTH:
                return inline
        items = [f"{pad}  {render(item, indent + 2)}" for item in value]
        return "[\n" + ",\n".join(items) + f"\n{pad}]"
    if isinstance(value, dict):
        if not value:
            return "{}"
        items = [f"{pad}  {json.dumps(key, ensure_ascii=False)}: "
                 f"{render(item, indent + 2)}" for key, item in value.items()]
        return "{\n" + ",\n".join(items) + f"\n{pad}}}"
    return json.dumps(value, ensure_ascii=False)


def write_output(destination, text):
    if destination == "-":
        sys.stdout.write(text)
        return
    try:
        with open(destination, "w") as f:
            f.write(text)
    except OSError as e:
        die(f"cannot write {destination}: {e.strerror}")


def emit(args, valid, lines, errors):
    if args.text:
        write_output(args.text, "".join(f"{line}\n"
                                        for line in (["VALID"] if valid else lines)))
    if args.json:
        report = {"valid": valid, "errors": errors}
        write_output(args.json, render(report) + "\n")
    return EXIT_VALID if valid else EXIT_INVALID


def main(argv):
    args = parse_args(argv)
    schema = load_json(args.schema, "schema")
    check_declared_version(schema, args.schema, args.ignore_declared_version)
    instance_text = read_instance_text(args.instance)
    ref_resources, ref_contents = load_ref_resources(
        args.ref, args.ignore_declared_version)
    registry = Registry().with_resources(ref_resources)

    try:
        Draft202012Validator.check_schema(schema)
    except SchemaError as e:
        die(f"{args.schema} is not a valid JSON Schema: {e.message}")

    instance, parse_verdicts = parse_instance(instance_text,
                                              args.reject_duplicate_members)
    if parse_verdicts:
        return emit(args, False,
                    [f"INVALID: {v['message']}" for v in parse_verdicts],
                    parse_verdicts)

    # $ref targets are resolved lazily, during validation rather than by
    # check_schema, so an unresolvable one surfaces here and must be reported
    # as an error (exit 2) rather than as an invalid instance.
    index = index_documents(schema, ref_contents)
    validator = Draft202012Validator(schema, registry=registry)
    try:
        errors = sorted(validator.iter_errors(instance),
                        key=lambda e: list(e.absolute_path))
    except _WrappedReferencingError as e:
        die(f"{args.schema} contains an unresolvable $ref: {e}")
    if not errors:
        return emit(args, True, [], [])
    return emit(args, False,
                verdict_lines(errors, schema, instance),
                tidy(errors_from(errors, schema, instance, validator, index)))


if __name__ == "__main__":
    sys.exit(main(sys.argv))
