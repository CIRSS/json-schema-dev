{
  "group": "authored messages",
  "description": "errorMessage is nonstandard and both libraries ignore it, so both wrappers read the messages out of the schema JSON and implement them the same way. An authored message is one of the two texts the wrappers generate rather than the libraries, so the two legs are contracted to emit it identically.",
  "cases": [
    {
      "name": "a plain-string errorMessage covers every failure within its subschema",
      "description": "A plain-string errorMessage replaces the library's message for any failure within its subschema.",
      "schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "errorMessage": "a record needs an id"
      },
      "instance": {},
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: a record needs an id"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "required",
              "clause": [
                "required"
              ],
              "particulars": {
                "missingProperty": "id"
              },
              "found": {}
            }
          ]
        }
      }
    },
    {
      "name": "an object errorMessage supplies one message per failing keyword",
      "description": "An object errorMessage supplies one message per failing keyword.",
      "schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "errorMessage": {
          "required": "a record needs an id",
          "type": "a record must be an object"
        }
      },
      "instance": {},
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: a record needs an id"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "required",
              "clause": [
                "required"
              ],
              "particulars": {
                "missingProperty": "id"
              },
              "found": {}
            }
          ]
        }
      }
    },
    {
      "name": "the object form selects the message for the keyword that actually failed",
      "description": "The same schema as the previous case, failing its other keyword.",
      "schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "errorMessage": {
          "required": "a record needs an id",
          "type": "a record must be an object"
        }
      },
      "instance": [],
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: a record must be an object"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "type",
              "clause": [
                "type"
              ],
              "constraint": {
                "type": "object"
              },
              "found": []
            }
          ]
        }
      }
    },
    {
      "name": "a failure no authored message covers keeps the library's own message",
      "description": "A failure no authored message covers keeps each library's own message — the divergence errorMessage exists to close.",
      "schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "errorMessage": {
          "required": "a record needs an id"
        }
      },
      "instance": {
        "id": 5
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /id: 5 is not of type 'string'"
          ],
          "ajv-validate": [
            "INVALID: /id: must be string"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "id"
              ],
              "keyword": "type",
              "clause": [
                "properties",
                "id",
                "type"
              ],
              "constraint": {
                "type": "string"
              },
              "found": 5
            }
          ]
        }
      }
    },
    {
      "name": "the nearest enclosing errorMessage beats an outer one",
      "description": "The lookup walks outward from the failing keyword and takes the first message it meets, so an inner message beats an outer one.",
      "schema": {
        "properties": {
          "id": {
            "type": "string",
            "errorMessage": "an id must be a string"
          }
        },
        "errorMessage": "the record is malformed"
      },
      "instance": {
        "id": 5
      },
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /id: an id must be a string"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "id"
              ],
              "keyword": "type",
              "clause": [
                "properties",
                "id",
                "type"
              ],
              "constraint": {
                "type": "string"
              },
              "found": 5
            }
          ]
        }
      }
    },
    {
      "name": "an errorMessage inside a $ref'd definition covers the failure it names",
      "description": "A definition factored out under $defs and applied by $ref is the ordinary way to write a schema that repeats itself, and the message belongs with the definition rather than at each referring site. The lookup has to cross the $ref boundary to find it.",
      "schema": {
        "$defs": {
          "flavor": {
            "enum": [
              "vanilla",
              "chocolate"
            ],
            "errorMessage": {
              "enum": "not a flavor this shop serves"
            }
          }
        },
        "properties": {
          "order": {
            "$ref": "#/$defs/flavor"
          }
        }
      },
      "instance": {
        "order": "pistachio"
      },
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /order: not a flavor this shop serves"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "order"
              ],
              "keyword": "enum",
              "clause": [
                "$defs",
                "flavor",
                "enum"
              ],
              "constraint": {
                "allowedValues": [
                  "vanilla",
                  "chocolate"
                ]
              },
              "found": "pistachio"
            }
          ]
        }
      }
    },
    {
      "name": "an errorMessage in a --ref'd file covers a failure inside that component",
      "description": "The same lookup across a file boundary rather than a pointer within one document: the message travels with the component that states the requirement.",
      "schema": {
        "properties": {
          "order": {
            "$ref": "https://example.org/flavor.json"
          }
        }
      },
      "refs": [
        {
          "$id": "https://example.org/flavor.json",
          "enum": [
            "vanilla",
            "chocolate"
          ],
          "errorMessage": {
            "enum": "not a flavor this shop serves"
          }
        }
      ],
      "instance": {
        "order": "pistachio"
      },
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /order: not a flavor this shop serves"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "order"
              ],
              "keyword": "enum",
              "clause": [
                "enum"
              ],
              "document": "https://example.org/flavor.json",
              "constraint": {
                "allowedValues": [
                  "vanilla",
                  "chocolate"
                ]
              },
              "found": "pistachio"
            }
          ]
        }
      }
    },
    {
      "name": "a message inside the $ref'd definition beats one at the referring site",
      "description": "Crossing the boundary does not change the rule: the lookup takes the first message it meets walking outward from the failing keyword, and the definition's own message is nearer than the one beside the $ref.",
      "schema": {
        "$defs": {
          "flavor": {
            "enum": [
              "vanilla",
              "chocolate"
            ],
            "errorMessage": {
              "enum": "not a flavor this shop serves"
            }
          }
        },
        "properties": {
          "order": {
            "$ref": "#/$defs/flavor",
            "errorMessage": "the order line is wrong"
          }
        }
      },
      "instance": {
        "order": "pistachio"
      },
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /order: not a flavor this shop serves"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "order"
              ],
              "keyword": "enum",
              "clause": [
                "$defs",
                "flavor",
                "enum"
              ],
              "constraint": {
                "allowedValues": [
                  "vanilla",
                  "chocolate"
                ]
              },
              "found": "pistachio"
            }
          ]
        }
      }
    },
    {
      "name": "an absolute pointer interpolates the instance value at that location",
      "description": "${/a/json/pointer} interpolates the instance value at that pointer, JSON-encoded, resolved from the instance root.",
      "schema": {
        "properties": {
          "artifacts": {
            "type": "array",
            "minItems": 2,
            "errorMessage": "expected at least two artifacts, got ${/artifacts}"
          }
        }
      },
      "instance": {
        "artifacts": [
          "one"
        ]
      },
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /artifacts: expected at least two artifacts, got [\"one\"]"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "artifacts"
              ],
              "keyword": "minItems",
              "clause": [
                "properties",
                "artifacts",
                "minItems"
              ],
              "constraint": {
                "limit": 2
              },
              "found": [
                "one"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "a relative pointer interpolates the failing value itself",
      "description": "${0} is the failing value, wherever it occurs. Ajv binds it only where some keyword has already forced the value into a variable, which verbose mode does for every error.",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "errorMessage": "each artifact must be a string; ${0} is not"
        }
      },
      "instance": [
        "ok",
        7
      ],
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /1: each artifact must be a string; 7 is not"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                1
              ],
              "keyword": "type",
              "clause": [
                "items",
                "type"
              ],
              "constraint": {
                "type": "string"
              },
              "found": 7
            }
          ]
        }
      }
    },
    {
      "name": "a relative pointer with a path climbs from the failing value and descends again",
      "description": "${1/digest} climbs one level from the failing value and descends again.",
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "size": {
              "type": "number",
              "errorMessage": "bad size on the artifact with digest ${1/digest}"
            }
          }
        }
      },
      "instance": [
        {
          "digest": "abc123",
          "size": "large"
        }
      ],
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /0/size: bad size on the artifact with digest \"abc123\""
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                0,
                "size"
              ],
              "keyword": "type",
              "clause": [
                "items",
                "properties",
                "size",
                "type"
              ],
              "constraint": {
                "type": "number"
              },
              "found": "large"
            }
          ]
        }
      }
    },
    {
      "name": "an unresolvable pointer is left in the message as written",
      "description": "A pointer that names nothing is left in the message verbatim rather than guessed at.",
      "schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "errorMessage": "missing id on ${/nonexistent/path}"
      },
      "instance": {},
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: missing id on ${/nonexistent/path}"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "required",
              "clause": [
                "required"
              ],
              "particulars": {
                "missingProperty": "id"
              },
              "found": {}
            }
          ]
        }
      }
    },
    {
      "name": "a required message can name each missing member",
      "description": "Under required, an object keyed by member name gives each missing member its own message.",
      "schema": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "errorMessage": {
          "required": {
            "name": "a record must be named",
            "digest": "a record must carry a digest"
          }
        }
      },
      "instance": {},
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: a record must be named",
          "INVALID: a record must carry a digest"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "required",
              "clause": [
                "required"
              ],
              "particulars": {
                "missingProperty": "name"
              },
              "found": {}
            },
            {
              "keyword": "required",
              "clause": [
                "required"
              ],
              "particulars": {
                "missingProperty": "digest"
              },
              "found": {}
            }
          ]
        }
      }
    },
    {
      "name": "a properties message covers any failure inside that member",
      "description": "Whatever keyword failed and however deep, a failure under the named member takes the member's message.",
      "schema": {
        "type": "object",
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 2
          }
        },
        "errorMessage": {
          "properties": {
            "size": "size must be a whole number of at least 2"
          }
        }
      },
      "instance": {
        "size": 1
      },
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /size: size must be a whole number of at least 2"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "size"
              ],
              "keyword": "minimum",
              "clause": [
                "properties",
                "size",
                "minimum"
              ],
              "constraint": {
                "comparison": ">=",
                "limit": 2
              },
              "found": 1
            }
          ]
        }
      }
    },
    {
      "name": "an items message covers the element at that index",
      "description": "items is an array of messages, one per element position.",
      "schema": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ],
        "errorMessage": {
          "items": [
            "the first element is a name",
            "the second element is a count"
          ]
        }
      },
      "instance": [
        "ok",
        "seven"
      ],
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /1: the second element is a count"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                1
              ],
              "keyword": "type",
              "clause": [
                "prefixItems",
                1,
                "type"
              ],
              "constraint": {
                "type": "integer"
              },
              "found": "seven"
            }
          ]
        }
      }
    },
    {
      "name": "the default message covers what no keyword message does",
      "description": "Under an object errorMessage, _ covers any failure in the subschema that no other entry does.",
      "schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "errorMessage": {
          "required": "a record needs an id",
          "_": "the record is malformed"
        }
      },
      "instance": [],
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: the record is malformed"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "type",
              "clause": [
                "type"
              ],
              "constraint": {
                "type": "object"
              },
              "found": []
            }
          ]
        }
      }
    },
    {
      "name": "a keyword message covers only the subschema it is written in",
      "description": "An outer message keyed by type does not reach a type failure inside a member's own subschema; that failure keeps the library's message.",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "errorMessage": {
          "type": "a record must be an object"
        }
      },
      "instance": {
        "id": 5
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /id: 5 is not of type 'string'"
          ],
          "ajv-validate": [
            "INVALID: /id: must be string"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "id"
              ],
              "keyword": "type",
              "clause": [
                "properties",
                "id",
                "type"
              ],
              "constraint": {
                "type": "string"
              },
              "found": 5
            }
          ]
        }
      }
    },
    {
      "name": "a message beside a $ref covers a failure inside the definition it refers to",
      "description": "Where the definition states no message of its own, the lookup continues outward to the referring site.",
      "schema": {
        "$defs": {
          "flavor": {
            "enum": [
              "vanilla",
              "chocolate"
            ]
          }
        },
        "properties": {
          "order": {
            "$ref": "#/$defs/flavor",
            "errorMessage": "the order line is wrong"
          }
        }
      },
      "instance": {
        "order": "pistachio"
      },
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /order: the order line is wrong"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "order"
              ],
              "keyword": "enum",
              "clause": [
                "$defs",
                "flavor",
                "enum"
              ],
              "constraint": {
                "allowedValues": [
                  "vanilla",
                  "chocolate"
                ]
              },
              "found": "pistachio"
            }
          ]
        }
      }
    },
    {
      "name": "a relative pointer resolves from where the message is written",
      "description": "${0} in a string message covering a deeper failure is the value the message's own subschema was applied to, not the deeper value that failed; the location reported is still the failure's.",
      "schema": {
        "type": "object",
        "properties": {
          "size": {
            "type": "number",
            "minimum": 4
          }
        },
        "errorMessage": "record ${0} is bad; size is ${/size}"
      },
      "instance": {
        "size": 1
      },
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /size: record {\"size\":1} is bad; size is 1"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "size"
              ],
              "keyword": "minimum",
              "clause": [
                "properties",
                "size",
                "minimum"
              ],
              "constraint": {
                "comparison": ">=",
                "limit": 4
              },
              "found": 1
            }
          ]
        }
      }
    },
    {
      "name": "a trailing hash interpolates the member name or index",
      "description": "${0#} is the name or index of the failing value within its parent.",
      "schema": {
        "type": "object",
        "properties": {
          "size": {
            "type": "number"
          }
        },
        "additionalProperties": {
          "not": true,
          "errorMessage": "extra member is ${0#}"
        }
      },
      "instance": {
        "size": 1,
        "bogus": 2
      },
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: /bogus: extra member is \"bogus\""
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "bogus"
              ],
              "keyword": "not",
              "clause": [
                "additionalProperties",
                "not"
              ],
              "found": 2
            }
          ]
        }
      }
    },
    {
      "name": "an additionalProperties message covers the member it rejects",
      "description": "A rejected member is reported at that member, carrying the keyword's message. (Several rejected members are the text form's recorded granularity defect, pinned in the offender-identity group.)",
      "schema": {
        "type": "object",
        "properties": {
          "size": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "errorMessage": {
          "additionalProperties": "only size is allowed"
        }
      },
      "instance": {
        "size": 1,
        "bogus": 2
      },
      "identicalMessages": true,
      "expect": {
        "exit": 1,
        "stdout": [
          "INVALID: only size is allowed"
        ],
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "bogus"
              ],
              "keyword": "additionalProperties",
              "clause": [
                "additionalProperties"
              ],
              "particulars": {
                "additionalProperty": "bogus"
              },
              "found": 2
            }
          ]
        }
      }
    }
  ]
}
