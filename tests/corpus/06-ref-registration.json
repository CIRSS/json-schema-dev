{
  "group": "schemas spread over several files",
  "description": "Each --ref FILE loads an additional schema and registers it under its $id, making it reachable by $ref from the main schema. Nothing is ever fetched from the $id's URI; it is a name to resolve against. A --ref schema without a $id is refused, because there is nothing else to register it under.",
  "cases": [
    {
      "name": "a component in its own file applies by $ref to its $id",
      "description": "A component in its own file, applied by $ref to its $id.",
      "schema": {
        "$id": "https://example.org/composite",
        "allOf": [
          {
            "$ref": "https://example.org/component"
          }
        ],
        "required": [
          "status"
        ]
      },
      "refs": [
        {
          "$id": "https://example.org/component",
          "type": "object",
          "required": [
            "id"
          ]
        }
      ],
      "instance": {
        "id": "x",
        "status": "final"
      },
      "expect": {
        "exit": 0,
        "stdout": [
          "VALID"
        ],
        "report": {
          "valid": true,
          "errors": []
        }
      }
    },
    {
      "name": "the component's requirements stay in force inside the composite",
      "description": "Both schemas' requirements are in force; this instance breaks the component's.",
      "schema": {
        "$id": "https://example.org/composite",
        "allOf": [
          {
            "$ref": "https://example.org/component"
          }
        ],
        "required": [
          "status"
        ]
      },
      "refs": [
        {
          "$id": "https://example.org/component",
          "type": "object",
          "required": [
            "id"
          ]
        }
      ],
      "instance": {
        "status": "final"
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 'id' is a required property"
          ],
          "ajv-validate": [
            "INVALID: must have required property 'id'"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "required",
              "clause": [
                "required"
              ],
              "document": "https://example.org/component",
              "particulars": {
                "missingProperty": "id"
              },
              "found": {
                "status": "final"
              }
            }
          ]
        }
      }
    },
    {
      "name": "omitting the --ref that defines a $ref target is an error, not a verdict",
      "description": "Without the --ref, the $ref resolves to nothing: an error, not a verdict.",
      "schema": {
        "$id": "https://example.org/composite",
        "allOf": [
          {
            "$ref": "https://example.org/component"
          }
        ]
      },
      "instance": {
        "id": "x"
      },
      "expect": {
        "exit": 2,
        "stdout": [],
        "report": null,
        "stderrContains": {
          "jsonschema-validate": "jsonschema-validate: error: {dir}/schema.json contains an unresolvable $ref: Unresolvable: https://example.org/component",
          "ajv-validate": "ajv-validate: error: {dir}/schema.json is not a valid JSON Schema: can't resolve reference https://example.org/component from id https://example.org/composite"
        }
      }
    },
    {
      "name": "a --ref file without a $id is refused",
      "schema": {
        "type": "object"
      },
      "refs": [
        {
          "type": "object",
          "required": [
            "id"
          ]
        }
      ],
      "instance": {},
      "expect": {
        "exit": 2,
        "stdout": [],
        "report": null,
        "stderrContains": {
          "jsonschema-validate": "jsonschema-validate: error: ref schema file {dir}/ref-0.json has no $id to register it under",
          "ajv-validate": "ajv-validate: error: ref schema file {dir}/ref-0.json has no $id to register it under"
        }
      }
    },
    {
      "name": "a chain of components resolves through both --ref files",
      "description": "A chain of components: the composite refers to one, which refers to another.",
      "schema": {
        "$id": "https://example.org/composite",
        "allOf": [
          {
            "$ref": "https://example.org/middle"
          }
        ]
      },
      "refs": [
        {
          "$id": "https://example.org/middle",
          "allOf": [
            {
              "$ref": "https://example.org/base"
            }
          ],
          "required": [
            "status"
          ]
        },
        {
          "$id": "https://example.org/base",
          "required": [
            "id"
          ]
        }
      ],
      "instance": {
        "status": "final"
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 'id' is a required property"
          ],
          "ajv-validate": [
            "INVALID: must have required property 'id'"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "required",
              "clause": [
                "required"
              ],
              "document": "https://example.org/base",
              "particulars": {
                "missingProperty": "id"
              },
              "found": {
                "status": "final"
              }
            }
          ]
        }
      }
    },
    {
      "name": "a registered schema nothing refers to changes no verdict",
      "schema": {
        "type": "object",
        "required": [
          "id"
        ]
      },
      "refs": [
        {
          "$id": "https://example.org/unused",
          "type": "string"
        }
      ],
      "instance": {
        "id": "x"
      },
      "expect": {
        "exit": 0,
        "stdout": [
          "VALID"
        ],
        "report": {
          "valid": true,
          "errors": []
        }
      }
    },
    {
      "name": "a $ref reaches a subschema inside a --ref file by pointer",
      "description": "A $id on a subschema names that subschema; a $ref can reach it directly.",
      "schema": {
        "$id": "https://example.org/composite",
        "properties": {
          "tag": {
            "$ref": "https://example.org/component#/$defs/tag"
          }
        }
      },
      "refs": [
        {
          "$id": "https://example.org/component",
          "$defs": {
            "tag": {
              "type": "string",
              "pattern": "^[a-z]+$"
            }
          }
        }
      ],
      "instance": {
        "tag": "NOT LOWER"
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /tag: 'NOT LOWER' does not match '^[a-z]+$'"
          ],
          "ajv-validate": [
            "INVALID: /tag: must match pattern \"^[a-z]+$\""
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "tag"
              ],
              "keyword": "pattern",
              "clause": [
                "$defs",
                "tag",
                "pattern"
              ],
              "document": "https://example.org/component",
              "constraint": {
                "pattern": "^[a-z]+$"
              },
              "found": "NOT LOWER"
            }
          ]
        }
      }
    },
    {
      "name": "an $anchor names a subschema without making it a resource",
      "description": "A $ref to \"#name\" resolves by anchor rather than by pointer. The clause is still reported as a path from the root of the document the caller gave, since that is the file a reader has open.",
      "schema": {
        "$defs": {
          "named": {
            "$anchor": "named",
            "properties": {
              "a": {
                "type": "number"
              }
            }
          }
        },
        "$ref": "#named"
      },
      "instance": {
        "a": "hello"
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /a: 'hello' is not of type 'number'"
          ],
          "ajv-validate": [
            "INVALID: /a: must be number"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "a"
              ],
              "keyword": "type",
              "clause": [
                "$defs",
                "named",
                "properties",
                "a",
                "type"
              ],
              "constraint": {
                "type": "number"
              },
              "found": "hello"
            }
          ]
        }
      }
    },
    {
      "name": "an $id on a subschema is a resource inside the document that carries it",
      "description": "An embedded $id makes a subschema addressable, and a $ref by that URI resolves to it without any file being registered. The clause is reported from the root of the command-line schema rather than from the embedded resource, so a reader can find it without first locating the $id.",
      "schema": {
        "$defs": {
          "named": {
            "$id": "https://example.org/named",
            "properties": {
              "a": {
                "type": "number"
              }
            }
          }
        },
        "$ref": "https://example.org/named"
      },
      "instance": {
        "a": "hello"
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /a: 'hello' is not of type 'number'"
          ],
          "ajv-validate": [
            "INVALID: /a: must be number"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "a"
              ],
              "keyword": "type",
              "clause": [
                "$defs",
                "named",
                "properties",
                "a",
                "type"
              ],
              "constraint": {
                "type": "number"
              },
              "found": "hello"
            }
          ]
        }
      }
    }
  ]
}
