            {
              "keyword": "required",
              "clause": [
                "allOf",
                1,
                "required"
              ],
              "particulars": {
                "missingProperty": "b"
              },
              "found": {}
            }
          ]
        }
      }
    },
    {
      "name": "a not failure has no failing value to describe",
      "description": "A not failure is a success that should not have happened, so there is no failing value to describe.",
