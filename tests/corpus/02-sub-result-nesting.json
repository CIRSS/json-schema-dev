          "ajv-validate": [
            "INVALID: must NOT be valid"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "not",
              "clause": [
                "not"
              ],
              "found": "text"
            }
          ]
        }
      }
    },
    {
