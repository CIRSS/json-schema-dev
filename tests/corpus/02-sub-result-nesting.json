    },
    {
      "name": "propertyNames applies its schema to member names, so the failing value is a name",
      "description": "propertyNames applies its schema to each member name, not to the value — so the failing value is a name.",
      "schema": {
        "propertyNames": {
          "pattern": "^[a-z]+$"
        }
      },
      "instance": {
        "ok": 1,
        "Not OK": 2
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 'Not OK' does not match '^[a-z]+$'"
          ],
          "ajv-validate": [
            "INVALID: must match pattern \"^[a-z]+$\"",
            "INVALID: property name must be valid"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "pattern",
              "clause": [
                "propertyNames",
                "pattern"
              ],
              "constraint": {
                "pattern": "^[a-z]+$"
              },
              "found": {
                "ok": 1,
                "Not OK": 2
              }
            }
          ]
        }
      },
      "defect": {
        "summary": "ajv-validate prints an applicator's sub-results as peers of its conclusion; jsonschema-validate prints the conclusion alone, so the two legs report different numbers of lines.",
        "divergent": true
      }
    },
    {
      "name": "prefixItems applies its schemas positionally",
