            "type": "string"
          },
          {
            "type": "number"
          }
        ]
      },
      "instance": [
        "ok",
        "not a number"
      ],
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /1: 'not a number' is not of type 'number'"
          ],
          "ajv-validate": [
            "INVALID: /1: must be number"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                1
              ],
              "keyword": "type",
              "clause": [
                "prefixItems",
                1,
                "type"
              ],
              "constraint": {
                "type": "number"
              },
              "found": "not a number"
            }
          ]
        }
      }
    },
    {
      "name": "a failure inside a $ref'd definition is reported at the referring member",
      "description": "A failure inside a $ref'd definition: whether the nesting survives the boundary is exactly what a prefix rule over schema pointers cannot be trusted about.",
      "schema": {
        "$defs": {
          "tagged": {
            "anyOf": [
              {
                "const": "a"
              },
              {
                "const": "b"
              }
            ]
          }
        },
        "properties": {
          "tag": {
            "$ref": "#/$defs/tagged"
          }
        }
      },
      "instance": {
        "tag": "z"
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /tag: 'z' is not valid under any of the given schemas"
          ],
          "ajv-validate": [
            "INVALID: /tag: must be equal to constant",
            "INVALID: /tag: must be equal to constant",
            "INVALID: /tag: must match a schema in anyOf"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "tag"
              ],
              "keyword": "anyOf",
              "clause": [
                "$defs",
                "tagged",
                "anyOf"
              ],
              "found": "z",
              "rejections": [
                {
                  "clause": [
                    "$defs",
                    "tagged",
                    "anyOf",
                    0
                  ],
                  "errors": [
                    {
                      "site": [
                        "tag"
                      ],
                      "keyword": "const",
                      "clause": [
                        "$defs",
                        "tagged",
                        "anyOf",
                        0,
                        "const"
                      ],
                      "constraint": {
                        "allowedValue": "a"
                      },
                      "found": "z"
                    }
                  ]
                },
                {
                  "clause": [
                    "$defs",
                    "tagged",
                    "anyOf",
                    1
                  ],
                  "errors": [
                    {
                      "site": [
                        "tag"
                      ],
                      "keyword": "const",
                      "clause": [
                        "$defs",
                        "tagged",
                        "anyOf",
                        1,
                        "const"
                      ],
                      "constraint": {
                        "allowedValue": "b"
                      },
                      "found": "z"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "defect": {
        "summary": "ajv-validate prints an applicator's sub-results as peers of its conclusion; jsonschema-validate prints the conclusion alone, so the two legs report different numbers of lines.",
        "divergent": true
      }
    },
