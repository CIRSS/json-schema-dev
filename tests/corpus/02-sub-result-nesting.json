{
  "group": "conclusions and the sub-results behind them",
  "description": "Applicator keywords produce a conclusion — the requirement the instance violated — and the sub-results that led to it. The wrappers currently print both as equal INVALID lines, which gives a reason the standing of a requirement. These cases pin what each keyword family reports today, per family, so the recovery can be tested rather than inferred from a prefix rule.",
  "cases": [
    {
      "name": "contains reports the array's failure, and ajv-validate each element's complaint behind it",
      "description": "contains requires one satisfying element. The conclusion is the array's failure; a per-element complaint is a sub-result and states no obligation.",
      "schema": {
        "type": "array",
        "contains": {
          "const": "core"
        }
      },
      "instance": [
        "ext1",
        "ext2"
      ],
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: ['ext1', 'ext2'] does not contain items matching the given schema"
          ],
          "ajv-validate": [
            "INVALID: /0: must be equal to constant",
            "INVALID: /1: must be equal to constant",
            "INVALID: must contain at least 1 valid item(s)"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "contains",
              "clause": [
                "contains"
              ],
              "constraint": {
                "minContains": 1
              },
              "found": [
                "ext1",
                "ext2"
              ],
              "rejections": [
                {
                  "site": [
                    0
                  ],
                  "errors": [
                    {
                      "site": [
                        0
                      ],
                      "keyword": "const",
                      "clause": [
                        "contains",
                        "const"
                      ],
                      "constraint": {
                        "allowedValue": "core"
                      },
                      "found": "ext1"
                    }
                  ]
                },
                {
                  "site": [
                    1
                  ],
                  "errors": [
                    {
                      "site": [
                        1
                      ],
                      "keyword": "const",
                      "clause": [
                        "contains",
                        "const"
                      ],
                      "constraint": {
                        "allowedValue": "core"
                      },
                      "found": "ext2"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "defect": {
        "summary": "ajv-validate prints an applicator's sub-results as peers of its conclusion; jsonschema-validate prints the conclusion alone, so the two legs report different numbers of lines.",
        "divergent": true
      }
    },
    {
      "name": "an empty array satisfies every items and no contains",
      "schema": {
        "type": "array",
        "contains": {
          "const": "core"
        }
      },
      "instance": [],
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: [] does not contain items matching the given schema"
          ],
          "ajv-validate": [
            "INVALID: must contain at least 1 valid item(s)"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "contains",
              "clause": [
                "contains"
              ],
              "constraint": {
                "minContains": 1
              },
              "found": []
            }
          ]
        }
      }
    },
    {
      "name": "anyOf reports its conclusion, and ajv-validate one sub-result per branch tried",
      "description": "anyOf reports the conclusion plus one sub-result per branch tried.",
      "schema": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "instance": "text",
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 'text' is not valid under any of the given schemas"
          ],
          "ajv-validate": [
            "INVALID: must be number",
            "INVALID: must be boolean",
            "INVALID: must match a schema in anyOf"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "anyOf",
              "clause": [
                "anyOf"
              ],
              "found": "text",
              "rejections": [
                {
                  "clause": [
                    "anyOf",
                    0
                  ],
                  "errors": [
                    {
                      "keyword": "type",
                      "clause": [
                        "anyOf",
                        0,
                        "type"
                      ],
                      "constraint": {
                        "type": "number"
                      },
                      "found": "text"
                    }
                  ]
                },
                {
                  "clause": [
                    "anyOf",
                    1
                  ],
                  "errors": [
                    {
                      "keyword": "type",
                      "clause": [
                        "anyOf",
                        1,
                        "type"
                      ],
                      "constraint": {
                        "type": "boolean"
                      },
                      "found": "text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "defect": {
        "summary": "ajv-validate prints an applicator's sub-results as peers of its conclusion; jsonschema-validate prints the conclusion alone, so the two legs report different numbers of lines.",
        "divergent": true
      }
    },
    {
      "name": "oneOf reports every branch that failed",
      "description": "oneOf, like anyOf, reports every branch that failed.",
