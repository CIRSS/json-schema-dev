          {
            "const": "final"
          }
        ]
      },
      "instance": "published",
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 'published' is not valid under any of the given schemas"
          ],
          "ajv-validate": [
            "INVALID: must be equal to constant",
            "INVALID: must be equal to constant",
            "INVALID: must match exactly one schema in oneOf"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "oneOf",
              "clause": [
                "oneOf"
              ],
              "particulars": {
                "passingSchemas": null
              },
              "found": "published",
              "rejections": [
                {
                  "clause": [
                    "oneOf",
                    0
                  ],
                  "errors": [
                    {
                      "keyword": "const",
                      "clause": [
                        "oneOf",
                        0,
                        "const"
                      ],
                      "constraint": {
                        "allowedValue": "draft"
                      },
                      "found": "published"
                    }
                  ]
                },
                {
                  "clause": [
                    "oneOf",
                    1
                  ],
                  "errors": [
                    {
                      "keyword": "const",
                      "clause": [
                        "oneOf",
                        1,
                        "const"
                      ],
                      "constraint": {
                        "allowedValue": "final"
                      },
                      "found": "published"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "defect": {
        "summary": "ajv-validate prints an applicator's sub-results as peers of its conclusion; jsonschema-validate prints the conclusion alone, so the two legs report different numbers of lines.",
        "divergent": true
      }
    },
    {
      "name": "oneOf fails when more than one branch matches, with no failing sub-result behind it",
      "description": "oneOf also fails when more than one branch matches — a conclusion with no failing sub-result behind it.",
      "schema": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "minimum": 0
          }
        ]
      },
      "instance": 5,
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 5 is valid under each of {'minimum': 0}, {'type': 'number'}"
          ],
          "ajv-validate": [
            "INVALID: must match exactly one schema in oneOf"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "oneOf",
              "clause": [
                "oneOf"
              ],
              "particulars": {
                "passingSchemas": [
                  0,
                  1
                ]
              },
              "found": 5
            }
          ]
        }
      }
    },
    {
      "name": "a conditional reports its conclusion under \"if\" and the failure under \"then\"",
      "description": "A conditional's conclusion and its sub-results sit at different schema locations: the conclusion under \"if\", the failure under \"then\".",
      "schema": {
        "if": {
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "circle"
            }
          }
        },
        "then": {
          "required": [
            "radius"
          ]
        }
      },
      "instance": {
        "kind": "circle"
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 'radius' is a required property"
          ],
          "ajv-validate": [
            "INVALID: must have required property 'radius'",
            "INVALID: must match \"then\" schema"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "required",
              "clause": [
                "then",
                "required"
              ],
              "particulars": {
                "missingProperty": "radius"
              },
              "found": {
                "kind": "circle"
              }
            }
          ]
        }
      },
      "defect": {
        "summary": "ajv-validate prints an applicator's sub-results as peers of its conclusion; jsonschema-validate prints the conclusion alone, so the two legs report different numbers of lines.",
        "divergent": true
      }
    },
    {
      "name": "a conditional reports the else branch's failure the same way",
      "description": "Ajv names the branch in params.failingKeyword; the conclusion still sits under \"if\".",
      "schema": {
        "if": {
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "circle"
            }
          }
        },
        "then": {
          "required": [
            "radius"
          ]
        },
        "else": {
          "required": [
            "side"
          ]
        }
      },
      "instance": {
        "kind": "square"
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 'side' is a required property"
          ],
          "ajv-validate": [
            "INVALID: must have required property 'side'",
            "INVALID: must match \"else\" schema"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "required",
              "clause": [
                "else",
                "required"
              ],
              "particulars": {
                "missingProperty": "side"
              },
              "found": {
                "kind": "square"
              }
            }
          ]
        }
      },
      "defect": {
        "summary": "ajv-validate prints an applicator's sub-results as peers of its conclusion; jsonschema-validate prints the conclusion alone, so the two legs report different numbers of lines.",
        "divergent": true
      }
    },
    {
      "name": "allOf's branches are peers, so each failure stands on its own",
      "description": "allOf's branches are peers, not sub-results: each failure stands on its own.",
      "schema": {
        "allOf": [
          {
            "required": [
              "a"
            ]
          },
          {
            "required": [
              "b"
            ]
          }
        ]
      },
      "instance": {},
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 'a' is a required property",
            "INVALID: 'b' is a required property"
          ],
          "ajv-validate": [
            "INVALID: must have required property 'a'",
            "INVALID: must have required property 'b'"
          ]
        },
        "report": {
          "valid": false,
