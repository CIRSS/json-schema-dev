              "clause": [
                "anyOf"
              ],
              "found": [
                "ext"
              ],
              "rejections": [
                {
                  "clause": [
                    "anyOf",
                    0
                  ],
                  "errors": [
                    {
                      "keyword": "type",
                      "clause": [
                        "anyOf",
                        0,
                        "allOf",
                        0,
                        "type"
                      ],
                      "constraint": {
                        "type": "object"
                      },
                      "found": [
                        "ext"
                      ]
                    }
                  ]
                },
                {
                  "clause": [
                    "anyOf",
                    1
                  ],
                  "errors": [
                    {
                      "keyword": "contains",
                      "clause": [
                        "anyOf",
