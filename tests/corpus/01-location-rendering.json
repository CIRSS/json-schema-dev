{
  "group": "where a failure is reported",
  "description": "Where in the instance a failure is reported. Every failure has a location — the root's is the empty JSON Pointer — and the corpus pins how each one is rendered, including the RFC 6901 escapes and the locations the current rendering cannot distinguish.",
  "cases": [
    {
      "name": "a failure of the whole instance is reported with no location",
      "description": "The location is the empty JSON Pointer, which both wrappers render by printing nothing.",
      "schema": {
        "type": "object"
      },
      "instance": 5,
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 5 is not of type 'object'"
          ],
          "ajv-validate": [
            "INVALID: must be object"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "type",
              "clause": [
                "type"
              ],
              "constraint": {
                "type": "object"
              },
              "found": 5
            }
          ]
        }
      }
    },
    {
      "name": "a missing top-level member is reported against the root object",
      "description": "A missing member is reported against the object that lacks it, which for a top-level requirement is the root.",
      "schema": {
        "type": "object",
        "required": [
          "b"
        ]
      },
      "instance": {
        "a": 1
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 'b' is a required property"
          ],
          "ajv-validate": [
            "INVALID: must have required property 'b'"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "keyword": "required",
              "clause": [
                "required"
              ],
              "particulars": {
                "missingProperty": "b"
              },
              "found": {
                "a": 1
              }
            }
          ]
        }
      }
    },
    {
      "name": "a failure inside a member is reported at that member's pointer",
      "description": "A failure inside a member is reported at that member's pointer.",
      "schema": {
        "properties": {
          "creator": {
            "type": "object",
            "required": [
              "id"
            ]
          }
        }
      },
      "instance": {
        "creator": {}
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /creator: 'id' is a required property"
          ],
          "ajv-validate": [
            "INVALID: /creator: must have required property 'id'"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "creator"
              ],
              "keyword": "required",
              "clause": [
                "properties",
                "creator",
                "required"
              ],
              "particulars": {
                "missingProperty": "id"
              },
              "found": {}
            }
          ]
        }
      }
    },
    {
      "name": "an array element's location is its index",
      "schema": {
        "items": {
          "type": "number"
        }
      },
      "instance": [
        1,
        "x",
        3
      ],
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /1: 'x' is not of type 'number'"
          ],
          "ajv-validate": [
            "INVALID: /1: must be number"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                1
              ],
              "keyword": "type",
              "clause": [
                "items",
                "type"
              ],
              "constraint": {
                "type": "number"
              },
              "found": "x"
            }
          ]
        }
      }
    },
    {
      "name": "locations compose down through objects and arrays alike",
      "schema": {
        "properties": {
          "records": {
            "items": {
              "properties": {
                "id": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "instance": {
        "records": [
          {
            "id": "ok"
          },
          {
            "id": 7
          }
        ]
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /records/1/id: 7 is not of type 'string'"
          ],
          "ajv-validate": [
            "INVALID: /records/1/id: must be string"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "records",
                1,
                "id"
              ],
              "keyword": "type",
              "clause": [
                "properties",
                "records",
                "items",
                "properties",
                "id",
                "type"
              ],
              "constraint": {
                "type": "string"
              },
              "found": 7
            }
          ]
        }
      }
    },
    {
      "name": "the member named \"\" is reported as though the whole instance had failed",
      "description": "RFC 6901 gives the member named \"\" the pointer \"/\" — a different location from the root, whose pointer is \"\". Both wrappers use \"/\" as their sentinel for the root, so this failure is rendered as though it were a failure of the whole instance.",
      "schema": {
        "properties": {
          "": {
            "type": "number"
          }
        }
      },
      "instance": {
        "": "not a number"
      },
      "defect": {
        "summary": "The member named \"\" is reported as a root failure, because \"/\" is used as the root sentinel."
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: 'not a number' is not of type 'number'"
          ],
          "ajv-validate": [
            "INVALID: must be number"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                ""
              ],
              "keyword": "type",
              "clause": [
                "properties",
                "",
                "type"
              ],
              "constraint": {
                "type": "number"
              },
              "found": "not a number"
            }
          ]
        }
      }
    },
    {
      "name": "a member name containing \"/\" goes unescaped, so its pointer reads as a nested member",
      "description": "RFC 6901 escapes \"/\" in a member name as \"~1\", so the member \"a/b\" of the root object has the pointer \"/a~1b\" — distinct from the member \"b\" of the member \"a\".",
      "schema": {
        "properties": {
          "a/b": {
            "type": "number"
          }
        }
      },
      "instance": {
        "a/b": "not a number"
      },
      "defect": {
        "summary": "jsonschema-validate joins path segments with \"/\" without escaping, so \"a/b\" renders as \"/a/b\" and is indistinguishable from a nested member. ajv-validate escapes correctly.",
        "divergent": true
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /a/b: 'not a number' is not of type 'number'"
          ],
          "ajv-validate": [
            "INVALID: /a~1b: must be number"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "a/b"
              ],
              "keyword": "type",
              "clause": [
                "properties",
                "a/b",
                "type"
              ],
              "constraint": {
                "type": "number"
              },
              "found": "not a number"
            }
          ]
        }
      }
    },
    {
      "name": "a member name containing \"~\" goes unescaped, so its pointer does not address it",
      "description": "RFC 6901 escapes \"~\" in a member name as \"~0\".",
      "schema": {
        "properties": {
          "a~b": {
            "type": "number"
          }
        }
      },
      "instance": {
        "a~b": "not a number"
      },
      "defect": {
        "summary": "jsonschema-validate does not escape \"~\", so the rendered pointer is not a valid JSON Pointer for this member.",
        "divergent": true
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /a~b: 'not a number' is not of type 'number'"
          ],
          "ajv-validate": [
            "INVALID: /a~0b: must be number"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "a~b"
              ],
              "keyword": "type",
              "clause": [
                "properties",
                "a~b",
                "type"
              ],
              "constraint": {
                "type": "number"
              },
              "found": "not a number"
            }
          ]
        }
      }
    },
    {
      "name": "each failure gets its own line and its own location",
      "schema": {
        "properties": {
          "a": {
            "type": "number"
          },
          "b": {
            "type": "number"
          }
        }
      },
      "instance": {
        "a": "x",
        "b": "y"
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: /a: 'x' is not of type 'number'",
            "INVALID: /b: 'y' is not of type 'number'"
          ],
          "ajv-validate": [
            "INVALID: /a: must be number",
            "INVALID: /b: must be number"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "a"
              ],
              "keyword": "type",
              "clause": [
                "properties",
                "a",
                "type"
              ],
              "constraint": {
                "type": "number"
              },
              "found": "x"
            },
            {
              "site": [
                "b"
              ],
              "keyword": "type",
              "clause": [
                "properties",
                "b",
                "type"
              ],
              "constraint": {
                "type": "number"
              },
              "found": "y"
            }
          ]
        }
      }
    },
    {
      "name": "a false schema at the root rejects with no keyword to name",
      "description": "A boolean is a schema. There is no keyword involved, so the report names none and locates the boolean itself.",
      "schema": false,
      "instance": {
        "a": 1
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: False schema does not allow {'a': 1}"
          ],
          "ajv-validate": [
            "INVALID: boolean schema is false"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "clause": [],
              "found": {
                "a": 1
              }
            }
          ]
        }
      }
    },
    {
      "name": "a false subschema is located at the member it rejected",
      "description": "python-jsonschema extends neither path for a boolean subschema: its error carries the parent's instance path and a schema path stopping at the applicator. The wrapper recovers the member from the applicator and the rejected value, so both legs report the same place.",
      "schema": {
        "properties": {
          "a": false
        }
      },
      "instance": {
        "a": 1
      },
      "expect": {
        "exit": 1,
        "stdout": {
          "jsonschema-validate": [
            "INVALID: False schema does not allow 1"
          ],
          "ajv-validate": [
            "INVALID: /a: boolean schema is false"
          ]
        },
        "report": {
          "valid": false,
          "errors": [
            {
              "site": [
                "a"
              ],
              "clause": [
                "properties",
                "a"
              ],
              "found": 1
            }
          ]
        }
      },
      "defect": {
        "summary": "The text form locates a false subschema's failure at the parent on the Python leg and at the member on the Node leg, because it prints each library's error as that library reported it and python-jsonschema extends neither path for a boolean subschema.",
        "divergent": true
      }
    }
  ]
}
