
NODE_VERSION=22.11.0

REPRO_NAME=json-schema-dev
REPRO_DOCKER_ORG=cirss
REPRO_IMAGE_TAG=latest

PARENT_BUILD_ARG_1=${NODE_VERSION}
PARENT_IMAGE=${REPRO_DOCKER_ORG}/${REPRO_NAME}-parent:latest

DOCKER_BUILD_PROGRESS=plain

image:                  build-image   ##
start:                  start-repro   ##

##

-include .review-ledger/host-makefile

# Local stand-in until this target lives in review-ledger/host-makefile.
# Calls that module's own review recipe in the trim directory: the REPRO
# target mapping is baked into the image and cannot be extended here.
.PHONY: update-reviews
## update-reviews:    Update REVIEWS.md without running the other reports.
update-reviews: session
	$(RUN_IN_REPRO) 'make -C ${REPRO_MNT}/.review-ledger -f report-makefile review'
